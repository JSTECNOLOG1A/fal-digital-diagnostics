# Método FAL — variáveis de produção (TEMPLATE)
# Copie no VPS: cp .env.production.example .env.production
# Nunca commitar `.env.production` com secrets reais.

# --- Postgres ---
POSTGRES_USER=fal
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=fal
FAL_APP_PASSWORD=CHANGE_ME_STRONG_FAL_APP_PASSWORD

# --- Auth JWT (mín. 32 chars cada; diferentes entre si) ---
JWT_ACCESS_SECRET=CHANGE_ME_JWT_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- App / CORS ---
CORS_ORIGINS=https://metodofal.clarityib.com.br

# --- Criptografia de credenciais de integração (64 hex = 32 bytes) ---
CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_0123456789abcdef0123456789abcdef0123456789abcdef

# --- Seed no boot (só no PRIMEIRO deploy; depois deixe false) ---
RUN_SEED_ON_BOOT=true
SEED_HQ_EMAIL=admin@metodofal.clarityib.com.br
SEED_HQ_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
SEED_TENANT_SLUG=demo
SEED_TENANT_NAME=Tenant Demo
