  "name": "ScopeTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "active_dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
