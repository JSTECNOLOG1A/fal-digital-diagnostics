{
  "name": "FinancialDfcClassificationOverride",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "financial_diagnosis_id": {
      "type": "string",
      "description": "FK para FinancialDiagnosis \u2014 o override \u00e9 escopado por diagn\u00f3stico."
    },
    "financial_upload_id": {
      "type": "string",
      "description": "Opcional \u2014 upload de origem. Override \u00e9 por diagn\u00f3stico + rubric_key, n\u00e3o por upload."
    },
    "period": {
      "type": "string",
      "description": "Opcional \u2014 per\u00edodo corrente da DFC. N\u00e3o obrigat\u00f3rio; override \u00e9 por diagn\u00f3stico + rubric_key."
    },
    "comparison_period": {
      "type": "string",
      "description": "Opcional \u2014 per\u00edodo comparativo."
    },
    "rubric_key": {
      "type": "string",
      "description": "Chave da rubrica \u2014 canonical_key para rubricas BP, account_code para non_cash_adjustment. \u00c9 a chave de deduplica\u00e7\u00e3o do override."
    },
    "rubric_label": {
      "type": "string",
      "description": "Label visual da rubrica (desnormalizado para exibi\u00e7\u00e3o)"
    },
    "canonical_key": {
      "type": "string",
      "description": "Canonical_key da rubrica BP (null para non_cash_adjustment)"
    },
    "group_label": {
      "type": "string",
      "description": "Grupo cont\u00e1bil de origem (desnormalizado)"
    },
    "auto_bucket": {
      "type": "string",
      "enum": [
        "cash",
        "non_cash_adjustment",
        "operating_asset",
        "operating_liability",
        "investing",
        "financing",
        "ignored",
        "requires_review"
      ],
      "description": "Bucket que a engine atribuiu automaticamente (antes do override)"
    },
    "manual_bucket": {
      "type": "string",
      "enum": [
        "cash",
        "non_cash_adjustment",
        "operating_asset",
        "operating_liability",
        "investing",
        "financing",
        "ignored",
        "requires_review"
      ],
      "description": "Bucket definido manualmente pelo usu\u00e1rio \u2014 prevalece sobre auto_bucket."
    },
    "reason": {
      "type": "string",
      "description": "Motivo opcional da reclassifica\u00e7\u00e3o manual"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "active = override em vigor; inactive = override desativado (mantido para rastreabilidade)"
    },
    "created_by": {
      "type": "string",
      "description": "Email do usu\u00e1rio que criou o override"
    },
    "updated_by": {
      "type": "string",
      "description": "Email do usu\u00e1rio que alterou o override"
    }
  },
  "required": [
    "tenant_id",
    "financial_diagnosis_id",
    "rubric_key",
    "auto_bucket",
    "manual_bucket",
    "status"
  ]
}