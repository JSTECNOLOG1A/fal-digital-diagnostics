{
  "name": "FinancialIntercompanyReconciliation",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "financial_diagnosis_id": {
      "type": "string"
    },
    "preparation_run_id": {
      "type": "string"
    },
    "period": {
      "type": "string",
      "description": "YYYY-MM"
    },
    "entity_a_id": {
      "type": "string"
    },
    "entity_a_name": {
      "type": "string"
    },
    "entity_b_id": {
      "type": "string"
    },
    "entity_b_name": {
      "type": "string"
    },
    "reconciliation_type": {
      "type": "string",
      "enum": [
        "intercompany_balance",
        "intercompany_revenue_expense",
        "intercompany_loan",
        "other"
      ]
    },
    "account_a_code": {
      "type": "string",
      "description": "Conta na entidade A (ex: Contas a Receber)"
    },
    "account_b_code": {
      "type": "string",
      "description": "Conta na entidade B (ex: Fornecedores)"
    },
    "account_a_canonical_key": {
      "type": "string"
    },
    "account_b_canonical_key": {
      "type": "string"
    },
    "amount_a": {
      "type": "number",
      "description": "Saldo informado por A contra B"
    },
    "amount_b": {
      "type": "number",
      "description": "Saldo informado por B contra A"
    },
    "matched_amount": {
      "type": "number",
      "description": "Menor valor absoluto entre A e B (quando sinais compat\u00edveis)"
    },
    "difference_amount": {
      "type": "number",
      "description": "|amount_a - amount_b|"
    },
    "status": {
      "type": "string",
      "enum": [
        "unmatched",
        "matched",
        "matched_with_difference",
        "under_review",
        "resolved"
      ],
      "default": "unmatched"
    },
    "resolution_notes": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "financial_diagnosis_id",
    "period",
    "entity_a_id",
    "entity_b_id",
    "status"
  ]
}