{
  "name": "FinancialMappingResolution",
  "type": "object",
  "properties": {
    "financial_upload_id": {
      "type": "string"
    },
    "financial_diagnosis_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "account_code": {
      "type": "string"
    },
    "account_description": {
      "type": "string"
    },
    "mapping_source": {
      "type": "string",
      "enum": [
        "client_specific",
        "account_plan",
        "excel_mapping",
        "unmapped"
      ]
    },
    "managerial_group": {
      "type": "string"
    },
    "managerial_rubric": {
      "type": "string"
    },
    "statement_family": {
      "type": "string"
    },
    "statement_section": {
      "type": "string"
    },
    "sign_rule": {
      "type": "string"
    },
    "resolved_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unresolved"
      ]
    },
    "blocking_issue": {
      "type": "boolean",
      "default": false
    },
    "blocking_reason": {
      "type": "string"
    },
    "processing_run_id": {
      "type": "string"
    },
    "publication_status": {
      "type": "string",
      "enum": [
        "candidate",
        "active",
        "superseded",
        "invalid"
      ],
      "default": "candidate"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "superseded_at": {
      "type": "string",
      "format": "date-time"
    },
    "invalidated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "financial_upload_id",
    "financial_diagnosis_id",
    "tenant_id",
    "account_code",
    "mapping_source"
  ]
}