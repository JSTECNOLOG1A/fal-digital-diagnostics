{
  "name": "FalMonitoring",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "assessment_id": {
      "type": "string",
      "description": "FK Assessment"
    },
    "cluster_key": {
      "type": "string",
      "description": "Chave do cluster monitorado"
    },
    "dimension_key": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "blocked"
      ],
      "default": "not_started",
      "description": "Status do monitoramento do cluster"
    },
    "progress_percentage": {
      "type": "number",
      "default": 0,
      "description": "Percentual de progresso 0-100"
    },
    "last_update": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima atualiza\u00e7\u00e3o"
    },
    "responsible": {
      "type": "string",
      "description": "Email do respons\u00e1vel"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "assessment_id",
    "cluster_key"
  ]
}