{
  "name": "FinancialDfcManualAdjustment",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "financial_diagnosis_id": {
      "type": "string"
    },
    "financial_upload_id": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "column_key": {
      "type": "string"
    },
    "activity": {
      "type": "string",
      "enum": [
        "operating",
        "investing",
        "financing"
      ]
    },
    "label": {
      "type": "string"
    },
    "value": {
      "type": "number"
    },
    "adjustment_type": {
      "type": "string",
      "enum": [
        "patrimonio_liquido",
        "reclassificacao",
        "outros"
      ],
      "default": "outros"
    },
    "notes": {
      "type": "string"
    },
    "justification": {
      "type": "string"
    },
    "previous_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "new_value": {
      "type": "number"
    },
    "reconciliation_effect": {
      "type": "number"
    },
    "source_snapshot_id": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_by": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "financial_diagnosis_id",
    "activity",
    "label",
    "value"
  ]
}