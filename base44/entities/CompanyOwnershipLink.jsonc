{
  "name": "CompanyOwnershipLink",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "group_id": {
      "type": "string"
    },
    "investor_company_id": {
      "type": "string",
      "description": "ID da empresa investidora (null se pessoa f\u00edsica)"
    },
    "investor_person_name": {
      "type": "string",
      "description": "Nome do investidor pessoa f\u00edsica (se aplic\u00e1vel)"
    },
    "invested_company_id": {
      "type": "string",
      "description": "ID da empresa investida"
    },
    "percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Percentual de participa\u00e7\u00e3o"
    },
    "relationship_type": {
      "type": "string",
      "enum": [
        "quotista",
        "acionista",
        "controladora",
        "coligada",
        "investidor_pessoa_fisica"
      ],
      "description": "Tipo de relacionamento societ\u00e1rio"
    },
    "voting_percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Percentual de direito de voto (opcional)"
    },
    "economic_percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Percentual econ\u00f4mico (opcional)"
    },
    "is_controller": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 controlador da investida"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre o v\u00ednculo"
    }
  },
  "required": [
    "tenant_id",
    "group_id",
    "invested_company_id",
    "percentage",
    "relationship_type"
  ]
}