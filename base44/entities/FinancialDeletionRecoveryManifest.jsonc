{
  "name": "FinancialDeletionRecoveryManifest",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "financial_diagnosis_id": {
      "type": "string"
    },
    "financial_upload_id": {
      "type": "string"
    },
    "processing_run_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "prepared",
        "deleting",
        "committed",
        "restoring",
        "restored",
        "recovery_failed"
      ],
      "default": "prepared"
    },
    "manifest_json": {
      "type": "object",
      "description": "Manifesto can\u00f4nico restaur\u00e1vel dos derivados capturados antes da opera\u00e7\u00e3o destrutiva"
    },
    "manifest_checksum": {
      "type": "string",
      "description": "SHA-256 can\u00f4nico de manifest_json"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "restored_at": {
      "type": "string",
      "format": "date-time"
    },
    "restore_error": {
      "type": "object"
    }
  },
  "required": [
    "tenant_id",
    "financial_diagnosis_id",
    "financial_upload_id",
    "processing_run_id",
    "status",
    "manifest_json",
    "manifest_checksum",
    "created_at"
  ]
}