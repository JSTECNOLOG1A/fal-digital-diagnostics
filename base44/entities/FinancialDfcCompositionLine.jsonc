{
  "name": "FinancialDfcCompositionLine",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "financial_diagnosis_id": {
      "type": "string"
    },
    "financial_upload_id": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "comparison_period": {
      "type": "string"
    },
    "column_key": {
      "type": "string"
    },
    "column_label": {
      "type": "string"
    },
    "period_type": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly",
        "annual",
        "ytd"
      ]
    },
    "rubric_key": {
      "type": "string"
    },
    "rubric_label": {
      "type": "string"
    },
    "canonical_key": {
      "type": "string"
    },
    "group_label": {
      "type": "string"
    },
    "previous_value": {
      "type": "number"
    },
    "current_value": {
      "type": "number"
    },
    "delta": {
      "type": "number"
    },
    "bucket": {
      "type": "string",
      "enum": [
        "cash",
        "non_cash_adjustment",
        "operating_asset",
        "operating_liability",
        "investing",
        "financing",
        "ignored",
        "requires_review"
      ]
    },
    "bucket_source": {
      "type": "string",
      "enum": [
        "canonical_map",
        "text_inference",
        "dfc_classification",
        "manual_override"
      ]
    },
    "impact_on_dfc": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "requires_review"
      ],
      "default": "active"
    },
    "dataset_scope": {
      "type": "string",
      "enum": [
        "individual",
        "combined",
        "parent",
        "consolidated"
      ]
    },
    "reporting_entity_id": {
      "type": "string"
    },
    "preparation_run_id": {
      "type": "string"
    },
    "processing_run_id": {
      "type": "string"
    },
    "publication_status": {
      "type": "string",
      "enum": [
        "candidate",
        "active",
        "superseded",
        "invalid"
      ],
      "default": "candidate"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "superseded_at": {
      "type": "string",
      "format": "date-time"
    },
    "invalidated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "financial_diagnosis_id",
    "period",
    "rubric_key",
    "bucket"
  ]
}