{
  "name": "FalClusterCause",
  "type": "object",
  "properties": {
    "cluster_key": {
      "type": "string",
      "description": "Chave do cluster"
    },
    "dimension_key": {
      "type": "string"
    },
    "cause_key": {
      "type": "string",
      "description": "Chave \u00fanica da causa (ex: sem_politica_alcadas)"
    },
    "cause_description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da causa prov\u00e1vel"
    },
    "probability_weight": {
      "type": "number",
      "default": 1,
      "description": "Peso de probabilidade (1-5)"
    },
    "trigger_score_below": {
      "type": "number",
      "default": 2.0,
      "description": "Score abaixo do qual esta causa \u00e9 relevante"
    }
  },
  "required": [
    "cluster_key",
    "cause_key",
    "cause_description"
  ]
}