{
  "name": "FinancialAdjustment",
  "type": "object",
  "properties": {
    "financial_upload_id": {
      "type": "string"
    },
    "financial_diagnosis_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "canonical_key": {
      "type": "string",
      "description": "Chave can\u00f4nica da rubrica sint\u00e9tica (group_label ou canonical_key da linha)"
    },
    "rubric_label": {
      "type": "string",
      "description": "Label da rubrica para exibi\u00e7\u00e3o"
    },
    "statement_code": {
      "type": "string",
      "enum": [
        "BP",
        "DRE"
      ]
    },
    "period": {
      "type": "string",
      "description": "YYYY-MM"
    },
    "value": {
      "type": "number",
      "description": "Valor do ajuste (positivo ou negativo)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o / justificativa do ajuste"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "financial_upload_id",
    "financial_diagnosis_id",
    "tenant_id",
    "canonical_key",
    "period",
    "value",
    "statement_code"
  ]
}