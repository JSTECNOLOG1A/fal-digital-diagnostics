{
  "name": "FinancialPeriodLock",
  "type": "object",
  "description": "Placeholder arquitetural da RC-1; n\u00e3o fornece exclus\u00e3o m\u00fatua em produ\u00e7\u00e3o sem primitivo at\u00f4mico documentado",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "financial_diagnosis_id": {
      "type": "string"
    },
    "source_entity_id": {
      "type": "string"
    },
    "reference_period": {
      "type": "string"
    },
    "statement_scope": {
      "type": "string"
    },
    "lock_key": {
      "type": "string"
    },
    "owner_token": {
      "type": "string"
    },
    "owner_run_id": {
      "type": "string"
    },
    "production_readiness": {
      "type": "string",
      "enum": [
        "not_production_ready"
      ],
      "default": "not_production_ready"
    },
    "status": {
      "type": "string",
      "enum": [
        "acquiring",
        "acquired",
        "released"
      ],
      "default": "acquiring"
    },
    "acquired_at": {
      "type": "string",
      "format": "date-time"
    },
    "lease_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_reason": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "financial_diagnosis_id",
    "lock_key",
    "owner_token",
    "status"
  ]
}