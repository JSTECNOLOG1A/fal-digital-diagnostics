{
  "name": "FinancialProcessingSnapshot",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "financial_diagnosis_id": {
      "type": "string"
    },
    "financial_processing_run_id": {
      "type": "string"
    },
    "previous_snapshot_id": {
      "type": "string"
    },
    "version_number": {
      "type": "number"
    },
    "analysis_type": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "dataset_scope": {
      "type": "string"
    },
    "entity_code": {
      "type": "string"
    },
    "reporting_entity_id": {
      "type": "string"
    },
    "perimeter": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "parent_entity_id": {
      "type": "string"
    },
    "eliminations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "statement_counts": {
      "type": "object"
    },
    "indicator_counts": {
      "type": "object"
    },
    "formula_version": {
      "type": "string"
    },
    "registry_version": {
      "type": "string"
    },
    "registry_hash": {
      "type": "string"
    },
    "perimeter_checksum": {
      "type": "string"
    },
    "elimination_checksum": {
      "type": "string"
    },
    "mapping_checksum": {
      "type": "string"
    },
    "dfc_adjustment_checksum": {
      "type": "string"
    },
    "source_manifest": {
      "type": "object"
    },
    "output_manifest": {
      "type": "object"
    },
    "integrity_summary": {
      "type": "object"
    },
    "input_checksum": {
      "type": "string"
    },
    "output_checksum": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "active",
        "invalid"
      ]
    },
    "invalid_reason": {
      "type": "string"
    },
    "invalidated_at": {
      "type": "string",
      "format": "date-time"
    },
    "invalidated_by_run_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "financial_diagnosis_id",
    "financial_processing_run_id",
    "version_number",
    "status",
    "source_manifest",
    "output_manifest",
    "input_checksum",
    "output_checksum"
  ]
}