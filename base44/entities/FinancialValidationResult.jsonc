{
  "name": "FinancialValidationResult",
  "type": "object",
  "properties": {
    "financial_upload_id": {
      "type": "string"
    },
    "financial_diagnosis_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "blocking",
        "warning",
        "info"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "estrutura_arquivo",
        "mapeamento",
        "balancete",
        "dre_composicao",
        "balanco_composicao",
        "periodicidade",
        "hierarquia",
        "dfc_composicao"
      ]
    },
    "code": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "sheet_name": {
      "type": "string"
    },
    "row_ref": {
      "type": "string"
    },
    "column_ref": {
      "type": "string"
    },
    "blocking": {
      "type": "boolean",
      "default": false
    },
    "dataset_scope": {
      "type": "string",
      "enum": [
        "individual",
        "combined",
        "parent",
        "consolidated"
      ]
    },
    "reporting_entity_id": {
      "type": "string"
    },
    "preparation_run_id": {
      "type": "string"
    },
    "processing_run_id": {
      "type": "string"
    },
    "publication_status": {
      "type": "string",
      "enum": [
        "candidate",
        "active",
        "superseded",
        "invalid"
      ]
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "superseded_at": {
      "type": "string",
      "format": "date-time"
    },
    "invalidated_at": {
      "type": "string",
      "format": "date-time"
    },
    "invalidation_reason": {
      "type": "string"
    }
  },
  "required": [
    "financial_diagnosis_id",
    "tenant_id",
    "severity",
    "category",
    "code",
    "title",
    "message",
    "processing_run_id",
    "publication_status"
  ]
}