{
  "name": "FinancialAnalysisNote",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "financial_diagnosis_id": {
      "type": "string"
    },
    "section": {
      "type": "string",
      "enum": [
        "statements",
        "indicators"
      ],
      "description": "Seção da análise a que este comentário manual pertence."
    },
    "content": {
      "type": "string",
      "description": "Texto livre redigido pelo consultor, combinado com a leitura automática na mesma seção."
    },
    "updated_by": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "financial_diagnosis_id",
    "section"
  ]
}
