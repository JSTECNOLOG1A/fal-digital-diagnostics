{
  "name": "DiagnosticLink",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "group_id": {
      "type": "string",
      "description": "Grupo ao qual o v\u00ednculo pertence"
    },
    "company_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "fal_assessment_id": {
      "type": "string",
      "description": "FK para Assessment FAL"
    },
    "financial_diagnosis_id": {
      "type": "string",
      "description": "FK para FinancialDiagnosis"
    },
    "link_type": {
      "type": "string",
      "enum": [
        "synthetic_analysis",
        "reference",
        "period_comparison"
      ],
      "default": "synthetic_analysis"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "inactive substitui exclus\u00e3o l\u00f3gica \u2014 nunca deletar v\u00ednculos"
    },
    "rationale": {
      "type": "string",
      "description": "Justificativa do v\u00ednculo"
    },
    "linked_by": {
      "type": "string",
      "description": "Email de quem criou o v\u00ednculo"
    },
    "linked_at": {
      "type": "string",
      "format": "date-time"
    },
    "unlinked_by": {
      "type": "string"
    },
    "unlinked_at": {
      "type": "string",
      "format": "date-time"
    },
    "unlink_reason": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "group_id",
    "fal_assessment_id",
    "financial_diagnosis_id",
    "linked_by",
    "linked_at",
    "link_type"
  ]
}