{
  "name": "FalRecommendationLibrary",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "null = entrada global da biblioteca"
    },
    "method_version_id": {
      "type": "string"
    },
    "recommendation_key": {
      "type": "string",
      "description": "Chave \u00fanica da recomenda\u00e7\u00e3o (ex: fal_rec_cluster_r0)"
    },
    "source": {
      "type": "string",
      "enum": [
        "global_library",
        "tenant_custom",
        "consultant_manual"
      ],
      "default": "global_library",
      "description": "Origem da recomenda\u00e7\u00e3o"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "cluster_rating",
        "question_rating",
        "manual"
      ],
      "default": "cluster_rating"
    },
    "dimension_key": {
      "type": "string",
      "description": "Chave da dimens\u00e3o (ex: governanca, financeiro)"
    },
    "subdimension_key": {
      "type": "string",
      "description": "Chave da subdimens\u00e3o (ex: planejamento_financeiro)"
    },
    "cluster_key": {
      "type": "string",
      "description": "Chave do cluster (ex: fluxo_caixa_semanal)"
    },
    "question_id": {
      "type": "string",
      "description": "ID da pergunta FAL \u2014 usado apenas para recomenda\u00e7\u00f5es espec\u00edficas por pergunta cr\u00edtica"
    },
    "trigger_score": {
      "type": "number",
      "enum": [
        0,
        1,
        2,
        3
      ],
      "description": "Nota FAL que dispara a recomenda\u00e7\u00e3o: 0=cr\u00edtico, 1=parcial, 2=melhoria, 3=adequado"
    },
    "gap_level": {
      "type": "number",
      "enum": [
        0,
        1,
        2
      ],
      "description": "N\u00edvel de lacuna acion\u00e1vel: 0=cr\u00edtico, 1=parcial, 2=melhoria. Null para trigger_score=3."
    },
    "is_actionable": {
      "type": "boolean",
      "default": true,
      "description": "true para trigger_score 0-2; false para trigger_score=3 (apenas monitoramento)"
    },
    "recommendation_type": {
      "type": "string",
      "enum": [
        "structural",
        "corrective",
        "improvement",
        "monitoring"
      ],
      "description": "Tipo derivado do trigger_score: 0=structural, 1=corrective, 2=improvement, 3=monitoring"
    },
    "recommendation_title": {
      "type": "string",
      "description": "T\u00edtulo da recomenda\u00e7\u00e3o estrat\u00e9gica"
    },
    "recommendation_description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada do problema e solu\u00e7\u00e3o"
    },
    "implementation_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Passos pr\u00e1ticos de implementa\u00e7\u00e3o"
    },
    "evidence_required": {
      "type": "string",
      "description": "Evid\u00eancias necess\u00e1rias para executar ou validar"
    },
    "success_indicators": {
      "type": "string",
      "description": "Indicadores de sucesso ap\u00f3s implementa\u00e7\u00e3o"
    },
    "routine_template": {
      "type": "string",
      "description": "Template de rotina pr\u00e1tica sugerida"
    },
    "impact_level": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Impacto esperado (1-5). Derivado da priority do CSV."
    },
    "effort_level": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Esfor\u00e7o de implementa\u00e7\u00e3o (1-5)"
    },
    "priority_weight": {
      "type": "number",
      "default": 50,
      "description": "Peso para prioriza\u00e7\u00e3o (0-100)"
    },
    "typical_owner": {
      "type": "string",
      "description": "Perfil do respons\u00e1vel (ex: gestor financeiro, CEO)"
    },
    "estimated_timeframe": {
      "type": "string",
      "enum": [
        "30d",
        "60d",
        "90d",
        "180d"
      ],
      "description": "Horizonte estimado de implementa\u00e7\u00e3o"
    },
    "cluster_question_count": {
      "type": "number",
      "description": "Quantidade de perguntas no cluster de origem"
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "cluster_key",
    "trigger_score",
    "is_actionable",
    "recommendation_type",
    "recommendation_title"
  ]
}