{
  "name": "FalClusterRecommendation",
  "type": "object",
  "properties": {
    "cluster_key": {
      "type": "string"
    },
    "dimension_key": {
      "type": "string"
    },
    "recommendation_key": {
      "type": "string"
    },
    "recommendation_text": {
      "type": "string"
    },
    "impact_level": {
      "type": "number",
      "default": 3,
      "description": "Impacto esperado 1-5"
    },
    "implementation_complexity": {
      "type": "number",
      "default": 3,
      "description": "Complexidade de implementa\u00e7\u00e3o 1-5 (1=simples)"
    },
    "estimated_time": {
      "type": "string",
      "description": "Ex: 30d, 60d, 90d, 180d"
    }
  },
  "required": [
    "cluster_key",
    "recommendation_key",
    "recommendation_text"
  ]
}