{
  "name": "FalQuestionSignal",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "question_id": {
      "type": "string",
      "description": "ID da FalQuestion"
    },
    "dimension_key": {
      "type": "string",
      "description": "Chave da dimens\u00e3o (ex: financeiro, governanca)"
    },
    "subdimension_key": {
      "type": "string",
      "description": "Chave da subdimens\u00e3o"
    },
    "cluster_key": {
      "type": "string",
      "description": "Chave do cluster"
    },
    "driver_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signal_type": {
      "type": "string",
      "enum": [
        "binary",
        "likert",
        "numeric",
        "multi"
      ],
      "default": "likert"
    },
    "bad_answers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Scores 0,1 ou valores que indicam problema"
    },
    "severity": {
      "type": "number",
      "default": 1.0,
      "description": "1-3: gravidade do sinal"
    },
    "confidence": {
      "type": "number",
      "default": 1.0,
      "description": "0-1: confian\u00e7a do mapeamento"
    },
    "weight": {
      "type": "number",
      "default": 1.0,
      "description": "Peso relativo na agrega\u00e7\u00e3o"
    },
    "root_cause_hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_playbook_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "question_id",
    "dimension_key"
  ]
}