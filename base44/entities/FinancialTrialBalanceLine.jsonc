{
  "name": "FinancialTrialBalanceLine",
  "type": "object",
  "properties": {
    "financial_upload_id": {
      "type": "string"
    },
    "financial_diagnosis_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "entity_code": {
      "type": "string"
    },
    "entity_level": {
      "type": "string",
      "enum": [
        "group",
        "company",
        "unit"
      ]
    },
    "period": {
      "type": "string"
    },
    "account_code": {
      "type": "string"
    },
    "account_description": {
      "type": "string"
    },
    "opening_balance": {
      "type": "number"
    },
    "debits": {
      "type": "number"
    },
    "credits": {
      "type": "number"
    },
    "closing_balance": {
      "type": "number"
    },
    "account_level": {
      "type": "number"
    },
    "is_analytic": {
      "type": "boolean"
    },
    "account_nature": {
      "type": "string",
      "enum": [
        "devedora",
        "credora"
      ]
    },
    "source_sheet": {
      "type": "string"
    },
    "source_row": {
      "type": "number"
    },
    "processing_run_id": {
      "type": "string"
    },
    "publication_status": {
      "type": "string",
      "enum": [
        "candidate",
        "active",
        "superseded",
        "invalid"
      ],
      "default": "candidate"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "superseded_at": {
      "type": "string",
      "format": "date-time"
    },
    "invalidated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "financial_upload_id",
    "financial_diagnosis_id",
    "tenant_id",
    "entity_code",
    "period",
    "account_code",
    "closing_balance"
  ]
}