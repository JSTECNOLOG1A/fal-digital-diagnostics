{
  "name": "FalCluster",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "dimension_key": {
      "type": "string",
      "description": "Chave da dimens\u00e3o pai"
    },
    "subdimension_key": {
      "type": "string",
      "description": "Chave da subdimens\u00e3o pai"
    },
    "key": {
      "type": "string",
      "description": "Chave \u00fanica do cluster (ex: requisicao_compras)"
    },
    "name": {
      "type": "string",
      "description": "Nome do cluster"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do cluster"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de apresenta\u00e7\u00e3o"
    }
  },
  "required": [
