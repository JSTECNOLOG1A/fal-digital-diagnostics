{
  "name": "FalConsultantPortfolio",
  "type": "object",
  "properties": {
    "consultant_id": {
      "type": "string",
      "description": "Email do consultor respons\u00e1vel"
    },
    "group_id": {
      "type": "string",
      "description": "FK Group (opcional)"
    },
    "company_id": {
      "type": "string",
      "description": "FK Company (opcional)"
    },
    "unit_id": {
      "type": "string",
      "description": "FK OperationalUnit (opcional)"
    },
    "tenant_id": {
      "type": "string"
    },
    "portfolio_status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "completed",
        "cancelled"
      ],
      "default": "active",
      "description": "Status do acompanhamento na carteira"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente (cache para exibi\u00e7\u00e3o)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "consultant_id",
    "tenant_id"
  ]
}