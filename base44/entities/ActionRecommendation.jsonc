{
  "name": "ActionRecommendation",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "assessment_id": {
      "type": "string"
    },
    "action_plan_id": {
      "type": "string"
    },
    "financial_diagnosis_id": {
      "type": "string"
    },
    "financial_finding_id": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "fal_diagnostic",
        "financial_diagnostic",
        "library",
        "ai",
        "manual"
      ],
      "default": "manual"
    },
    "source_ref_id": {
      "type": "string"
    },
    "dimension_key": {
      "type": "string"
    },
    "subdimension_key": {
      "type": "string"
    },
    "cluster_key": {
      "type": "string"
    },
    "question_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "recommendation_text": {
      "type": "string"
    },
    "rationale": {
      "type": "string",
      "description": "Por que esta recomenda\u00e7\u00e3o importa \u2014 o racional t\u00e9cnico"
    },
    "practical_steps": {
      "type": "string",
      "description": "Passo a passo pr\u00e1tico de execu\u00e7\u00e3o"
    },
    "evidence_required": {
      "type": "string",
      "description": "Evid\u00eancias necess\u00e1rias para executar"
    },
    "expected_deliverable": {
      "type": "string",
      "description": "Entreg\u00e1vel esperado ao final"
    },
    "expected_result": {
      "type": "string",
      "description": "Resultado esperado ap\u00f3s implementa\u00e7\u00e3o"
    },
    "suggested_owner_area": {
      "type": "string"
    },
    "suggested_deadline_days": {
      "type": "number"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "impact_score": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "effort_score": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "complexity_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "consultant_origin_context": {
      "type": "string",
      "enum": [
        "feeling_tecnico",
        "reuniao",
        "visita",
        "evidencia_observada",
        "solicitacao_administracao",
        "outro"
      ],
      "description": "Contexto de origem para recomenda\u00e7\u00f5es manuais do consultor"
    },
    "status": {
      "type": "string",
      "enum": [
        "suggested",
        "approved",
        "rejected",
        "needs_classification",
        "converted_to_tasks",
        "cancelled"
      ],
      "default": "needs_classification"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejected_reason": {
      "type": "string"
    },
    "converted_task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das tarefas criadas a partir desta recomenda\u00e7\u00e3o"
    },
    "converted_at": {
      "type": "string",
      "format": "date-time"
    },
    "converted_by": {
      "type": "string"
    },
    "suggest_to_library": {
      "type": "boolean",
      "default": false
    },
    "library_entry_id": {
      "type": "string",
      "description": "FK para ActionRecommendationLibrary se foi sugerida"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "title",
    "recommendation_text",
    "source_type"
  ]
}