{
  "name": "SyntheticDiagnosticSnapshot",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "diagnostic_link_id": {
      "type": "string",
      "description": "FK para DiagnosticLink"
    },
    "group_id": {
      "type": "string"
    },
    "fal_assessment_id": {
      "type": "string"
    },
    "financial_diagnosis_id": {
      "type": "string"
    },
    "maturity_summary": {
      "type": "string",
      "description": "S\u00edntese da maturidade operacional FAL"
    },
    "financial_summary": {
      "type": "string",
      "description": "S\u00edntese da situa\u00e7\u00e3o financeira"
    },
    "integrated_summary": {
      "type": "string",
      "description": "Leitura integrada FAL + Financeiro"
    },
    "correlations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fal_dimension": {
            "type": "string"
          },
          "financial_indicator": {
            "type": "string"
          },
          "interpretation": {
            "type": "string"
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "possible_explanation": {
            "type": "string"
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      }
    },
    "synthetic_risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_by": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "diagnostic_link_id",
    "group_id",
    "fal_assessment_id",
    "financial_diagnosis_id"
  ]
}