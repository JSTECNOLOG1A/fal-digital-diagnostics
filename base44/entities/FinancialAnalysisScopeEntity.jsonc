{
  "name": "FinancialAnalysisScopeEntity",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "financial_diagnosis_id": {
      "type": "string",
      "description": "FK para FinancialDiagnosis"
    },
    "entity_id": {
      "type": "string",
      "description": "ID da entidade (Company.id ou OperationalUnit.id)"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "company",
        "unit",
        "group"
      ]
    },
    "entity_name": {
      "type": "string",
      "description": "Nome desnormalizado para exibi\u00e7\u00e3o"
    },
    "role": {
      "type": "string",
      "enum": [
        "analyzed_entity",
        "presenting_entity",
        "parent",
        "subsidiary",
        "combined_member"
      ],
      "description": "Papel da entidade no per\u00edmetro da an\u00e1lise"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "direct_ownership_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "% de participa\u00e7\u00e3o direta da controladora"
    },
    "indirect_ownership_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "voting_rights_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "control_type": {
      "type": "string",
      "enum": [
        "control",
        "joint_control",
        "significant_influence",
        "none"
      ],
      "default": "none"
    },
    "consolidation_method": {
      "type": "string",
      "enum": [
        "full",
        "equity_method",
        "not_applicable"
      ],
      "default": "not_applicable"
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_to": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "tenant_id",
    "financial_diagnosis_id",
    "entity_id",
    "entity_type",
    "role"
  ]
}