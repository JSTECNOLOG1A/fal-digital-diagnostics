{
  "name": "FinancialActionProposal",
  "type": "object",
  "properties": {
    "financial_diagnosis_id": {
      "type": "string"
    },
    "financial_recommendation_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critica",
        "alta",
        "media",
        "baixa"
      ],
      "default": "media"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "approved",
        "exported",
        "rejected"
      ],
      "default": "proposed"
    },
    "exported_to_fal": {
      "type": "boolean",
      "default": false
    },
    "fal_action_plan_id": {
      "type": "string"
    },
    "fal_action_task_id": {
      "type": "string"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "consultant_adjustment": {
      "type": "string"
    }
  },
  "required": [
    "financial_diagnosis_id",
    "tenant_id",
    "title",
    "priority"
  ]
}