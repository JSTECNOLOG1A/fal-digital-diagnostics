/// Visita de acompanhamento do consultor — abre em draft, acumula mudanças
/// de tarefas (ActionTaskReview) e fecha com completeActionPlanReview.
model ActionPlanReview {
  id           String  @id @default(uuid()) @db.Uuid
  actionPlanId String  @map("action_plan_id") @db.Uuid
  /// Opcional pelo mesmo motivo de ActionPlan.assessmentId — herda do plano
  /// no momento da abertura (open()); nulo pra planos de origem financeira.
  assessmentId String? @map("assessment_id") @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid

  reviewKey    String @map("review_key")
  commitStatus String @default("active") @map("commit_status")

  reviewNumber Int      @map("review_number")
  reviewDate   DateTime @map("review_date") @db.Date
  visitType    String   @default("intermediate") @map("visit_type")

  consultantId   String? @map("consultant_id") @db.Uuid
  consultantName String? @map("consultant_name")

  executiveSummary        String?  @map("executive_summary")
  overallProgressBefore    Decimal? @map("overall_progress_before") @db.Decimal(5, 2)
  overallProgressAfter     Decimal? @map("overall_progress_after") @db.Decimal(5, 2)
  falDimensionScoresSnapshot Json?  @map("fal_dimension_scores_snapshot")

  openingSnapshot Json? @map("opening_snapshot")
  closingSnapshot Json? @map("closing_snapshot")

  status String @default("draft")

  openedAt          DateTime? @map("opened_at")
  openedBy          String?   @map("opened_by")
  cancelledAt       DateTime? @map("cancelled_at")
  cancelledBy       String?   @map("cancelled_by")
  cancellationReason String?  @map("cancellation_reason")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  plan   ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)

  taskReviews ActionTaskReview[]

  @@index([tenantId])
  @@index([actionPlanId])
  @@map("action_plan_reviews")
}

/// Log de auditoria de cada execução de generateActionPlan — versão
/// simplificada do ledger candidate/active/invalid do base44 original (ver
/// nota de escopo no topo desta seção: Postgres já garante atomicidade via
/// transação, então isso aqui é só histórico, não uma máquina de estados).
model ActionPlanGenerationOperation {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  assessmentId String  @map("assessment_id") @db.Uuid
  actionPlanId String? @map("action_plan_id") @db.Uuid

  operationId       String  @map("operation_id")
  status            String  @default("active")
  inputFingerprint  String? @map("input_fingerprint")
  generationSummary Json?   @map("generation_summary")

  startedAt   DateTime  @default(now()) @map("started_at")
  startedBy   String?   @map("started_by")
  completedAt DateTime? @map("completed_at")
  errorCode   String?   @map("error_code")
  errorMessage String?  @map("error_message")

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  plan   ActionPlan? @relation(fields: [actionPlanId], references: [id])

  @@index([tenantId])
  @@index([assessmentId])
  @@map("action_plan_generation_operations")
}

// ── Marco 4: Bibliotecas de conteúdo restantes ──
//
// FalClusterMeta, FalDriverCatalog, FalRootCauseCatalog e FalQuestionSignal
// NÃO foram migrados: os três últimos só alimentam o motor legado de
// insights (computeInsights/FalInsightSnapshot), já excluído do escopo
// desta migração; FalClusterMeta só ajusta pesos de computeFalPriority, que
// já degrada corretamente pro DEFAULT_META sem ela — nenhum dos quatro tem
// dado real importado nesta sessão, então seriam tabelas vazias sem uso.

/// Catálogo dinâmico de ações do motor de plano — biblioteca global (ou por
/// tenant, sobrepondo a global por action_key). Fallback: BUILTIN_ACTION_LIBRARY
/// embutido no código quando uma ação não está aqui.
model FalActionLibrary {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String?  @map("tenant_id") @db.Uuid
  actionKey            String   @map("action_key")
  title                String
  description          String?
  dimensionKey         String   @map("dimension_key")
  subdimensionKey      String?  @map("subdimension_key")
  clusterKey           String?  @map("cluster_key")
  driverIds            String[] @map("driver_ids")
  scoreTriggerMax      Decimal  @default(2.5) @map("score_trigger_max") @db.Decimal(4, 2)
  killerQuestionTrigger Boolean @default(false) @map("killer_question_trigger")
  impactScore          Int?     @map("impact_score")
  effortScore          Int?     @map("effort_score")
  actionType           String?  @map("action_type")
  defaultHorizon       String?  @map("default_horizon")
  typicalOwner         String?  @map("typical_owner")
  dependencyActionKeys String[] @map("dependency_action_keys")
  levelApplicability   String[] @map("level_applicability")
  sectorTags           String[] @map("sector_tags")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, actionKey])
  @@index([clusterKey])
  @@index([dimensionKey])
  @@map("fal_action_library")
}

// ── Marco 5: Relatórios ──
//
// generatePdfFromReportVersion no base44 original NÃO gera um PDF binário
// no servidor — ele reconstrói o payload de exibição a partir do
// payload_snapshot imutável, e o PDF real é montado no navegador
// (html2canvas/jsPDF) e só então enviado pro storage. Por isso não há
// nenhuma infraestrutura de renderização de PDF no backend aqui — só o
// versionamento imutável do snapshot + o rastreamento do artefato final.
// synthetic_integrated e financial_diagnostic (tipos de relatório que
// dependem de DiagnosticLink/SyntheticDiagnosticSnapshot/FinancialFinding —
// nenhum migrado) não são suportados; os demais 7 tipos funcionam.

/// Versão imutável de um relatório de assessment — nunca é sobrescrita,
/// cada geração cria uma nova linha com um payload_snapshot congelado.
model AssessmentReportVersion {
  id           String  @id @default(uuid()) @db.Uuid
  assessmentId String  @map("assessment_id") @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  actionPlanId String? @map("action_plan_id") @db.Uuid
  reviewId     String? @map("review_id") @db.Uuid

  reportType           String  @map("report_type")
  reportTitle          String  @map("report_title")
  reportVersionNumber  Int     @default(1) @map("report_version_number")
  reportCode           String  @map("report_code")
  previousReportVersionId String? @map("previous_report_version_id") @db.Uuid

  status                    String  @default("draft")
  actionPlanReviewId        String? @map("action_plan_review_id") @db.Uuid
  assessmentRevisionNumber  Int?    @map("assessment_revision_number")
  presetId                  String? @map("preset_id")
  reportParameters          Json?   @map("report_parameters")
  payloadSnapshot           Json?   @map("payload_snapshot")
  payloadChecksum           String? @map("payload_checksum")
  sourceManifest            Json?   @map("source_manifest")
  diagnosticSnapshotId      String? @map("diagnostic_snapshot_id") @db.Uuid
  prioritySnapshotId        String? @map("priority_snapshot_id") @db.Uuid
  actionPlanSnapshotId      String? @map("action_plan_snapshot_id") @db.Uuid

  pdfStatus            String?   @map("pdf_status")
  pdfFileUrl           String?   @map("pdf_file_url")
  pdfUploadIdentifier  String?   @map("pdf_upload_identifier")
  pdfChecksum          String?   @map("pdf_checksum")
  pdfGeneratedAt       DateTime? @map("pdf_generated_at")
  pdfStartedAt         DateTime? @map("pdf_started_at")
  pdfStartedBy         String?   @map("pdf_started_by")
  pdfOperationId       String?   @map("pdf_operation_id")
  pdfGeneratorVersion  String?   @map("pdf_generator_version")
  pdfPageCount         Int?      @map("pdf_page_count")
  pdfFileSize          Int?      @map("pdf_file_size")
  pdfStorageProvider   String?   @map("pdf_storage_provider")
  pdfStorageKey        String?   @map("pdf_storage_key")
  pdfError             String?   @map("pdf_error")
  htmlSnapshotUrl      String?   @map("html_snapshot_url")

  generatedAt   DateTime? @map("generated_at")
  generatedBy   String?   @map("generated_by")
  notes         String?
  errorMessage  String?   @map("error_message")
  markAsOfficial Boolean  @default(false) @map("mark_as_official")
  archivedAt    DateTime? @map("archived_at")
  archivedBy    String?   @map("archived_by")
  archiveReason String?   @map("archive_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([assessmentId, reportType])
  @@map("assessment_report_versions")
}

// ── Marco 6: itens descobertos na auditoria final (publicação, escopos
// multi-entidade, substituição de pergunta) ──
//
// restructureFalMatrix (a 4ª função levantada na auditoria) NÃO foi
// portada de propósito: é uma ferramenta administrativa de migração
// estrutural única ("único script autorizado a reestruturar a matriz"),
// da mesma família de seedFalClusters/migrateFalQuestionBank já
// desativadas no próprio base44 original. As 311 perguntas reais
// importadas nesta sessão já vieram no formato pós-reestruturação (mesma
// fonte que alimenta falOfficialMatrix.js no frontend) — rodar essa
// migração contra dado que já está correto seria risco sem ganho.

/// Detalhamento por entidade×dimensão de um Assessment multi-entidade
/// (assessment_mode='multi_entity_master') — gerado por
/// generateAssessmentScopes a partir do dimension_target_mapping guardado
/// em Assessment.metadata.
model AssessmentScope {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  assessmentId String @map("assessment_id") @db.Uuid

  dimensionKey            String  @map("dimension_key")
  evaluatedEntityType      String  @map("evaluated_entity_type")
  evaluatedEntityId        String  @map("evaluated_entity_id") @db.Uuid
  evaluatedEntityName      String? @map("evaluated_entity_name")
  weight                   Decimal @default(1) @map("weight") @db.Decimal(4, 2)
  samplingMode             String  @default("full") @map("sampling_mode")
  includeInConsolidatedScore Boolean @default(true) @map("include_in_consolidated_score")

  status          String   @default("not_started")
  questionCount   Int      @default(0) @map("question_count")
  answeredCount   Int      @default(0) @map("answered_count")
  requiredCount   Int      @default(0) @map("required_count")
  completionRatio Decimal  @default(0) @map("completion_ratio") @db.Decimal(4, 3)
  score           Decimal? @db.Decimal(6, 2)
  maturityLevel   String?  @map("maturity_level")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, dimensionKey, evaluatedEntityId])
  @@index([tenantId])
  @@map("assessment_scopes")
}

/// Auditoria de substituição de pergunta dentro do question_set de um
/// assessment (consultor troca uma pergunta não aplicável por uma
/// equivalente) — ver swapFalQuestion.
model FalQuestionSwap {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  assessmentId String @map("assessment_id") @db.Uuid

  originalQuestionId    String  @map("original_question_id") @db.Uuid
  replacementQuestionId String  @map("replacement_question_id") @db.Uuid
  dimensionKey          String? @map("dimension_key")
  subdimensionKey       String? @map("subdimension_key")
  clusterKey            String? @map("cluster_key")
  swapReason            String  @map("swap_reason")
  swapReasonLabel       String? @map("swap_reason_label")
  fallbackLevel         String? @map("fallback_level")
  swappedBy             String  @map("swapped_by")
  swappedAt             DateTime @default(now()) @map("swapped_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, originalQuestionId])
  @@index([tenantId])
  @@map("fal_question_swaps")
}
