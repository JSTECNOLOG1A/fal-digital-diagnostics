generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_OWNER")
}

enum AppRole {
  hq_admin
  tenant_admin
  consultant
  client_viewer
}

enum AccessStatus {
  active
  invited
  revoked
  suspended
}

enum SyncJobStatus {
  pending
  running
  succeeded
  failed
  cancelled
}


enum DataSubjectRequestType {
  access
  rectification
  erasure
  portability
  objection
}

enum DataSubjectRequestStatus {
  received
  in_progress
  completed
  rejected
}

enum IntegrationDirection {
  outbound
  inbound
  bidirectional
}

enum WebhookDeliveryStatus {
  pending
  delivered
  failed
  skipped
}

model Tenant {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  logoUrl   String?   @map("logo_url")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users               User[]
  groups              Group[]
  companies           Company[]
  operationalUnits    OperationalUnit[]
  auditLogs           AuditLog[]
  invites             UserInvite[]
  protheusConnections ProtheusConnection[]
  protheusSyncJobs    ProtheusSyncJob[]
  protheusStagingRows ProtheusStagingRow[]
  clients             Client[]
  methodVersions      MethodVersion[]
  assessments         Assessment[]
  falResponses          FalResponse[]
  mqeResponses          MQEResponse[]
  falContentSuggestions FalContentSuggestion[]
  assessmentFlowStates       AssessmentFlowState[]
  falDiagnosticSnapshots     FalDiagnosticSnapshot[]
  systemicCrossingAnalyses   SystemicCrossingAnalysis[]
  systemicDimensionImpacts   SystemicDimensionImpact[]
  falAggregateSnapshots      FalAggregateSnapshot[]
  actionPlans                ActionPlan[]
  actionTasks                ActionTask[]
  actionTaskActivities       ActionTaskActivity[]
  actionTaskReviews          ActionTaskReview[]
  actionRecommendations      ActionRecommendation[]
  actionRecommendationLibrary ActionRecommendationLibrary[]
  falActionLibrary            FalActionLibrary[]
  assessmentReportVersions    AssessmentReportVersion[]
  assessmentScopes            AssessmentScope[]
  falQuestionSwaps            FalQuestionSwap[]
  actionPlanReviews          ActionPlanReview[]
  actionPlanGenerationOperations ActionPlanGenerationOperation[]
  dataSubjectRequests DataSubjectRequest[]
  integrationConnections     IntegrationConnection[]
  integrationApiKeys         IntegrationApiKey[]
  integrationWebhookEndpoints IntegrationWebhookEndpoint[]
  integrationWebhookDeliveries IntegrationWebhookDelivery[]
  integrationInboundEvents   IntegrationInboundEvent[]
  integrationJobs            IntegrationJob[]
  financialAccountPlans       FinancialAccountPlan[]
  financialAccountPlanLines   FinancialAccountPlanLine[]
  financialDiagnoses          FinancialDiagnosis[]
  financialUploads            FinancialUpload[]
  financialJourneyPositions   FinancialJourneyPosition[]
  financialProcessingRuns     FinancialProcessingRun[]
  financialValidationResults  FinancialValidationResult[]
  financialStatementLines     FinancialStatementLine[]
  financialIndicatorSnapshots FinancialIndicatorSnapshot[]
  financialTrialBalanceLines  FinancialTrialBalanceLine[]
  financialMappingResolutions FinancialMappingResolution[]
  financialDfcCompositionLines      FinancialDfcCompositionLine[]
  financialDfcManualAdjustments     FinancialDfcManualAdjustment[]
  financialDfcClassificationOverrides FinancialDfcClassificationOverride[]
  financialFindings           FinancialFinding[]
  financialRecommendations    FinancialRecommendation[]
  financialActionProposals    FinancialActionProposal[]
  financialReportVersions     FinancialReportVersion[]

  @@map("tenants")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String       @map("password_hash")
  role         AppRole      @default(consultant)
  tenantId     String?      @map("tenant_id") @db.Uuid
  clientId     String?      @map("client_id") @db.Uuid
  accessStatus AccessStatus @default(active) @map("access_status")
  lastLoginAt  DateTime?    @map("last_login_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  tenant              Tenant?              @relation(fields: [tenantId], references: [id])
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  invitesSent         UserInvite[]         @relation("InviteSender")
  assessmentsCreated  Assessment[]         @relation("AssessmentCreator")
  dataSubjectRequests DataSubjectRequest[] @relation("DsrHandler")
  financialJourneyPositions FinancialJourneyPosition[]

  @@index([tenantId])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  actor  User?   @relation("AuditActor", fields: [actorId], references: [id])

  @@index([tenantId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

model UserInvite {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  email             String
  name              String
  role              AppRole
  clientId          String?      @map("client_id") @db.Uuid
  invitedById       String?      @map("invited_by_id") @db.Uuid
  status            AccessStatus @default(invited)
  temporaryPassword String?      @map("temporary_password")
  expiresAt         DateTime     @map("expires_at")
  acceptedAt        DateTime?    @map("accepted_at")
  revokedAt         DateTime?    @map("revoked_at")
  createdAt         DateTime     @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  invitedBy User?  @relation("InviteSender", fields: [invitedById], references: [id])

  @@index([tenantId, email])
  @@map("user_invites")
}

model Group {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  companies Company[]
  financialAccountPlans FinancialAccountPlan[]
  financialDiagnoses    FinancialDiagnosis[]
  assessments           Assessment[]

  @@index([tenantId])
  @@map("groups")
}

model Company {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  name      String
  cnpj      String?
  sector    String?
  erpSystem String?   @map("erp_system")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant            @relation(fields: [tenantId], references: [id])
  group  Group             @relation(fields: [groupId], references: [id])
  units  OperationalUnit[]
  financialDiagnoses FinancialDiagnosis[]
  assessments        Assessment[]

  @@index([tenantId])
  @@index([groupId])
  @@map("companies")
}

model OperationalUnit {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String
  code      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  financialDiagnoses FinancialDiagnosis[]
  assessments        Assessment[]

  @@index([tenantId])
  @@index([companyId])
  @@map("operational_units")
}

model ProtheusConnection {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  baseUrl           String    @map("base_url")
  username          String
  encryptedPassword String    @map("encrypted_password")
  companyCode       String    @map("company_code")
  branchCode        String?   @map("branch_code")
  isActive          Boolean   @default(true) @map("is_active")
  lastSyncAt        DateTime? @map("last_sync_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant Tenant            @relation(fields: [tenantId], references: [id])
  jobs   ProtheusSyncJob[]

  @@unique([tenantId])
  @@map("protheus_connections")
}

model ProtheusSyncJob {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  connectionId String        @map("connection_id") @db.Uuid
  resource     String
  status       SyncJobStatus @default(pending)
  startedAt    DateTime?     @map("started_at")
  finishedAt   DateTime?     @map("finished_at")
  errorMessage String?       @map("error_message")
  stats        Json?
  createdAt    DateTime      @default(now()) @map("created_at")

  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  connection ProtheusConnection   @relation(fields: [connectionId], references: [id])
  staging    ProtheusStagingRow[]

  @@index([tenantId, status])
  @@map("protheus_sync_jobs")
}

model ProtheusStagingRow {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  jobId      String   @map("job_id") @db.Uuid
  resource   String
  externalId String   @map("external_id")
  payload    Json
  syncedAt   DateTime @default(now()) @map("synced_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  job    ProtheusSyncJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([tenantId, resource, externalId, jobId])
  @@index([tenantId, resource])
  @@map("protheus_staging_rows")
}

/// Catálogo do Método FAL (versão imutável após publish)
model MethodVersion {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  code        String
  name        String
  version     String
  isPublished Boolean   @default(false) @map("is_published")
  payload     Json?
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  assessments Assessment[]
  mqeQuestions MQEQuestion[]
  falQuestions FalQuestion[]

  @@unique([tenantId, code, version])
  @@index([tenantId])
  @@map("method_versions")
}

model Client {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  document  String?
  email     String?
  phone     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  assessments Assessment[]

  @@index([tenantId])
  @@map("clients")
}

model Assessment {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  clientId        String?          @map("client_id") @db.Uuid
  methodVersionId String?          @map("method_version_id") @db.Uuid
  title           String
  displayName     String?          @map("display_name")
  /// Vocabulário aberto herdado do base44 (draft, in_progress, scoring,
  /// completed, published, archived, ...) — string livre, não enum, porque
  /// novos valores de status continuam aparecendo em telas legadas.
  status          String           @default("draft")
  createdById     String?          @map("created_by_id") @db.Uuid
  startedAt       DateTime?        @map("started_at")
  completedAt     DateTime?        @map("completed_at")

  /// Escopo hierárquico do diagnóstico 8D — mesmo padrão de FinancialDiagnosis
  /// (nível único por diagnóstico; group para o combinado do grupo).
  groupId    String? @map("group_id") @db.Uuid
  companyId  String? @map("company_id") @db.Uuid
  unitId     String? @map("unit_id") @db.Uuid
  targetType String? @map("target_type")
  targetId   String? @map("target_id") @db.Uuid
  cycleLabel String? @map("cycle_label")

  /// Metadados de negócio herdados do base44 (CreateAssessmentDialog /
  /// FalAssessmentSetupPage) — os mais consultados viram colunas de verdade.
  assessmentType   String?  @map("assessment_type")
  assessmentMode   String   @default("single_entity") @map("assessment_mode")
  competence       String?
  cycleNumber      Int?     @map("cycle_number")
  cycleId          String?  @map("cycle_id")
  contextNote      String?  @map("context_note")
  penaltyProfileKey String? @map("penalty_profile_key")
  assignedTo       String?  @map("assigned_to")
  scopeMode        String?  @map("scope_mode")
  recipientName    String?  @map("recipient_name")

  /// Cauda longa de campos legados de telas específicas (wizard multi-
  /// entidade FalAssessmentSetupPage: diagnostic_cycle, dimension_target_
  /// mapping, linked_entities, scope_hash, configuration_status,
  /// coverage_mode, report_status, e o que mais aparecer — o base44 nunca
  /// teve schema fixo pra Assessment). Guardado como JSON pra não perder
  /// dado nenhum nem travar toda vez que uma tela legada manda um campo
  /// novo; os campos realmente consultados/filtrados viram coluna própria
  /// (ver acima). O mapper do frontend (clarityMappers.js) faz esse split.
  metadata Json @default("{}")

  /// Dimensões ativas (governanca, juridico, controles_internos, financeiro,
  /// contabil, tributario, operacional, sistemas) — chaves em português,
  /// mesmo padrão do base44/buildFalQuestionSet.
  activeDimensions String[] @map("active_dimensions")
  diagnosticDepth  String   @default("rapid") @map("diagnostic_depth")

  /// question_set: ids de FalQuestion selecionados para este assessment —
  /// congelado no momento da montagem, não recalculado a cada leitura.
  questionSet         String[]  @map("question_set")
  progressPercentage  Int       @default(0) @map("progress_percentage")
  lastSavedAt         DateTime? @map("last_saved_at")
  lastSubdimensionKey String?   @map("last_subdimension_key")

  /// Incrementado a cada mudança relevante em FalResponse (score/justificativa/
  /// evidência) — espelha base44/onFalResponseChange. Usado por AssessmentFlowState
  /// pra saber se um snapshot já calculado ficou "stale" (respostas mudaram depois).
  currentResponseVersion Int @default(0) @map("current_response_version")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  client        Client?          @relation(fields: [clientId], references: [id])
  methodVersion MethodVersion?   @relation(fields: [methodVersionId], references: [id])
  createdBy     User?            @relation("AssessmentCreator", fields: [createdById], references: [id])
  group         Group?           @relation(fields: [groupId], references: [id])
  company       Company?         @relation(fields: [companyId], references: [id])
  unit          OperationalUnit? @relation(fields: [unitId], references: [id])

  falResponses         FalResponse[]
  mqeResponses         MQEResponse[]
  falContentSuggestions FalContentSuggestion[]
  flowState            AssessmentFlowState?
  diagnosticSnapshots  FalDiagnosticSnapshot[]
  systemicCrossings    SystemicCrossingAnalysis[]
  systemicDimensionImpacts SystemicDimensionImpact[]
  actionPlans ActionPlan[]
  reportVersions AssessmentReportVersion[]
  scopes AssessmentScope[]
  questionSwaps FalQuestionSwap[]

  @@index([tenantId, status])
  @@index([clientId])
  @@index([groupId])
  @@index([companyId])
  @@index([unitId])
  @@map("assessments")
}

/// Banco global de perguntas do questionário 8D — biblioteca compartilhada
/// entre tenants (mesmo padrão do base44 FalQuestion: sem tenant_id).
model FalQuestion {
  id                  String   @id @default(uuid()) @db.Uuid
  questionId          String   @unique @map("question_id")
  dimensionKey        String   @map("dimension_key")
  subdimensionKey     String   @map("subdimension_key")
  clusterKey          String   @map("cluster_key")
  processStage        String   @map("process_stage")
  sequenceOrder       Int      @default(0) @map("sequence_order")
  diagnosticDepth     String[] @map("diagnostic_depth")
  levelApplicability  String[] @map("level_applicability")
  questionWeight      Decimal  @default(1) @map("question_weight") @db.Decimal(6, 2)
  questionText        String   @map("question_text")
  guidance            String?
  evidenceHint        String?  @map("evidence_hint")
  isKillerQuestion    Boolean  @default(false) @map("is_killer_question")
  isCritical          Boolean  @default(false) @map("is_critical")
  dependency          String?
  /// Discriminador de método/diagnóstico. NULL = FAL 8D clássico (comportamento
  /// atual, intocado). Preenchido = pertence a um MethodVersion específico
  /// (ex.: Reforma Tributária 8D) e só entra no questionário de assessments
  /// que apontam para esse mesmo MethodVersion — evita misturar bancos de
  /// perguntas de diagnósticos diferentes que reaproveitam as mesmas dimension_key.
  methodVersionId     String?  @map("method_version_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  methodVersion         MethodVersion?          @relation(fields: [methodVersionId], references: [id])
  falResponses          FalResponse[]
  falContentSuggestions FalContentSuggestion[]

  @@index([clusterKey])
  @@index([dimensionKey])
  @@index([methodVersionId])
  @@map("fal_questions")
}

/// Biblioteca global de recomendações por cluster/trigger_score — mesmo
/// padrão "global" do base44 (tenant_id é uma string livre, normalmente
/// literal "global"; não é FK pra Tenant, ver nota do bug de import corrigido
/// nesta sessão: importador gravava null e generateActionPlan consultava
/// 'global' — nunca batiam).
model FalRecommendationLibrary {
  id                    String   @id @default(uuid()) @db.Uuid
  recommendationKey     String   @unique @map("recommendation_key")
  source                String?
  sourceType            String?  @map("source_type")
  dimensionKey          String   @map("dimension_key")
  subdimensionKey       String?  @map("subdimension_key")
  clusterKey            String   @map("cluster_key")
  questionId            String?  @map("question_id")
  triggerScore          Int?     @map("trigger_score")
  gapLevel              Int?     @map("gap_level")
  isActionable          Boolean  @default(true) @map("is_actionable")
  recommendationType    String?  @map("recommendation_type")
  recommendationTitle   String   @map("recommendation_title")
  recommendationDescription String? @map("recommendation_description")
  implementationSteps   String[] @map("implementation_steps")
  evidenceRequired      String?  @map("evidence_required")
  successIndicators     String?  @map("success_indicators")
  routineTemplate       String?  @map("routine_template")
  effortLevel           Int?     @map("effort_level")
  impactLevel           Int?     @map("impact_level")
  priorityWeight        Int?     @map("priority_weight")
  typicalOwner          String?  @map("typical_owner")
  estimatedTimeframe    String?  @map("estimated_timeframe")
  clusterQuestionCount  Int?     @map("cluster_question_count")
  tenantId              String   @default("global") @map("tenant_id")
  version               String   @default("1.0")
  notes                 String?
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([clusterKey])
  @@index([clusterKey, triggerScore])
  @@map("fal_recommendation_library")
}

/// Resposta de um consultor a uma FalQuestion, dentro de um Assessment.
model FalResponse {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  assessmentId         String    @map("assessment_id") @db.Uuid
  falQuestionId        String    @map("fal_question_id") @db.Uuid
  dimensionKey         String    @map("dimension_key")
  subdimensionKey      String?   @map("subdimension_key")
  clusterKey           String?   @map("cluster_key")
  score                Int
  justification        String?
  confidenceLevel      String    @default("auto_declarada") @map("confidence_level")
  flag                 String?
  evidenceNotes        String?   @map("evidence_notes")
  evidenceFileUrls     String[]  @map("evidence_file_urls")
  evaluatedEntityId    String?   @map("evaluated_entity_id") @db.Uuid
  evaluatedEntityType  String?   @map("evaluated_entity_type")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  assessment  Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  falQuestion FalQuestion @relation(fields: [falQuestionId], references: [id])

  @@index([tenantId])
  @@index([assessmentId])
  @@index([assessmentId, dimensionKey])
  @@map("fal_responses")
}

/// Perguntas de cruzamento MQE (par de dimensões) — biblioteca global.
model MQEQuestion {
  id           String   @id @default(uuid()) @db.Uuid
  methodVersionId String @map("method_version_id") @db.Uuid
  crossingKey  String   @map("crossing_key")
  code         String?
  text         String
  weight       Decimal  @default(1) @map("weight") @db.Decimal(6, 2)
  order        Int      @default(0)
  guidance     String?
  sectorTags   String[] @map("sector_tags")
  sectorType   String?  @map("sector_type")
  evidenceHint String?  @map("evidence_hint")
  riskTag      String?  @map("risk_tag")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  methodVersion MethodVersion @relation(fields: [methodVersionId], references: [id])
  mqeResponses  MQEResponse[]

  @@index([crossingKey])
  @@map("mqe_questions")
}

model MQEResponse {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  assessmentId    String   @map("assessment_id") @db.Uuid
  mqeQuestionId   String   @map("mqe_question_id") @db.Uuid
  crossingKey     String   @map("crossing_key")
  score           Int
  justification   String?
  divergenceNotes String?  @map("divergence_notes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  assessment  Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  mqeQuestion MQEQuestion @relation(fields: [mqeQuestionId], references: [id])

  @@index([tenantId])
  @@index([assessmentId])
  @@map("mqe_responses")
}

/// Copiloto de IA — sugestões de novas perguntas/recomendações, pendentes
/// de revisão humana antes de virarem FalQuestion/FalRecommendationLibrary
/// de verdade. Ver base44/functions/generateFalContentSuggestions (origem).
model FalContentSuggestion {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String?   @map("tenant_id") @db.Uuid
  contentType           String    @default("question") @map("content_type")
  dimensionKey          String?   @map("dimension_key")
  subdimensionKey       String?   @map("subdimension_key")
  clusterKey            String    @map("cluster_key")
  trigger               String    @default("manual")
  requestedBy           String?   @map("requested_by")
  modelUsed             String?   @map("model_used")
  promptContextSummary  String?   @map("prompt_context_summary")
  draftPayload          Json      @map("draft_payload")
  status                String    @default("pending")
  reviewedBy            String?   @map("reviewed_by")
  reviewedAt            DateTime? @map("reviewed_at")
  reviewComment         String?   @map("review_comment")
  publishedEntityId     String?   @map("published_entity_id") @db.Uuid
  assessmentId          String?   @map("assessment_id") @db.Uuid
  falQuestionId         String?   @map("fal_question_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  assessment  Assessment?  @relation(fields: [assessmentId], references: [id])
  falQuestion FalQuestion? @relation(fields: [falQuestionId], references: [id])

  @@index([clusterKey])
  @@index([status])
  @@map("fal_content_suggestions")
}

/// Solicitações do titular (LGPD / ISO 27701-aligned)
model DataSubjectRequest {
  id           String                    @id @default(uuid()) @db.Uuid
  tenantId     String                    @map("tenant_id") @db.Uuid
  type         DataSubjectRequestType
  status       DataSubjectRequestStatus  @default(received)
  subjectEmail String                    @map("subject_email")
  subjectName  String?                   @map("subject_name")
  details      String?
  handledById  String?                   @map("handled_by_id") @db.Uuid
  dueAt        DateTime?                 @map("due_at")
  completedAt  DateTime?                 @map("completed_at")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  handledBy User?  @relation("DsrHandler", fields: [handledById], references: [id])

  @@index([tenantId, status])
  @@index([subjectEmail])
  @@map("data_subject_requests")
}

/// Conexão genérica FAL ↔ sistema externo (credenciais criptografadas)
model IntegrationConnection {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  provider           String               /// ex: protheus, sap, custom
  name               String
  direction          IntegrationDirection @default(outbound)
  baseUrl            String?              @map("base_url")
  authType           String               @default("api_key") @map("auth_type") /// api_key | basic | oauth2 | none
  encryptedSecrets   String?              @map("encrypted_secrets") /// JSON cifrado
  config             Json?                /// metadados não-sensíveis
  isActive           Boolean              @default(true) @map("is_active")
  lastSuccessAt      DateTime?            @map("last_success_at")
  lastErrorAt        DateTime?            @map("last_error_at")
  lastErrorMessage   String?              @map("last_error_message")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  deletedAt          DateTime?            @map("deleted_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  jobs   IntegrationJob[]

  @@unique([tenantId, provider, name])
  @@index([tenantId, provider])
  @@map("integration_connections")
}

/// API Key para sistemas parceiros chamarem o FAL (inbound)
model IntegrationApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  keyPrefix   String    @map("key_prefix") /// fal_live_xxxx (visível)
  keyHash     String    @unique @map("key_hash") /// sha256
  scopes      String[]  @default([]) /// ex: groups:read, companies:write, webhooks:receive
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([keyPrefix])
  @@map("integration_api_keys")
}

/// Endpoint de webhook que o FAL chama (outbound)
model IntegrationWebhookEndpoint {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  name             String
  targetUrl        String    @map("target_url")
  encryptedSecret  String?   @map("encrypted_secret") /// HMAC signing secret
  events           String[]  @default([]) /// group.created, company.updated, ...
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  tenant     Tenant                       @relation(fields: [tenantId], references: [id])
  deliveries IntegrationWebhookDelivery[]

  @@index([tenantId])
  @@map("integration_webhook_endpoints")
}

model IntegrationWebhookDelivery {
  id           String                @id @default(uuid()) @db.Uuid
  tenantId     String                @map("tenant_id") @db.Uuid
  endpointId   String                @map("endpoint_id") @db.Uuid
  event        String
  payload      Json
  status       WebhookDeliveryStatus @default(pending)
  attempts     Int                   @default(0)
  responseCode Int?                  @map("response_code")
  errorMessage String?               @map("error_message")
  deliveredAt  DateTime?             @map("delivered_at")
  createdAt    DateTime              @default(now()) @map("created_at")

  tenant   Tenant                     @relation(fields: [tenantId], references: [id])
  endpoint IntegrationWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([endpointId])
  @@map("integration_webhook_deliveries")
}

/// Eventos recebidos de sistemas externos (inbound webhook / push)
model IntegrationInboundEvent {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  provider     String
  eventType    String    @map("event_type")
  externalId   String?   @map("external_id")
  payload      Json
  headers      Json?
  processedAt  DateTime? @map("processed_at")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, provider, createdAt])
  @@index([tenantId, externalId])
  @@map("integration_inbound_events")
}

/// Job genérico de sync/processamento de integração
model IntegrationJob {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  connectionId   String?       @map("connection_id") @db.Uuid
  provider       String
  jobType        String        @map("job_type") /// sync | push | pull | webhook_dispatch
  status         SyncJobStatus @default(pending)
  startedAt      DateTime?     @map("started_at")
  finishedAt     DateTime?     @map("finished_at")
  errorMessage   String?       @map("error_message")
  stats          Json?
  createdAt      DateTime      @default(now()) @map("created_at")

  tenant     Tenant                 @relation(fields: [tenantId], references: [id])
  connection IntegrationConnection? @relation(fields: [connectionId], references: [id])

  @@index([tenantId, status])
  @@index([connectionId])
  @@map("integration_jobs")
}

// ─────────────────────────────────────────────────────────────────────────
// Diagnóstico Financeiro — Fase 1 (estrutura / fontes / validação)
// Porta a jornada financeira que antes existia só como funções serverless
// Base44 (sem persistência real localmente) para tabelas Postgres reais.
// Cobre apenas analysisType = 'individual' por enquanto; 'combined' e
// 'consolidated' (conciliação, cédula, combinação/preparação) ficam para
// uma fase futura.
// ─────────────────────────────────────────────────────────────────────────

/// Plano de contas financeiro de um Grupo (cabeçalho).
model FinancialAccountPlan {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  groupId     String    @map("group_id") @db.Uuid
  name        String
  description String?
  version     String?
  isActive    Boolean   @default(true) @map("is_active")
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant    Tenant                     @relation(fields: [tenantId], references: [id])
  group     Group                      @relation(fields: [groupId], references: [id])
  lines     FinancialAccountPlanLine[]
  diagnoses FinancialDiagnosis[]

  @@index([tenantId])
  @@index([groupId])
  @@map("financial_account_plans")
}

/// Linha (conta) de um plano de contas financeiro.
model FinancialAccountPlanLine {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  accountPlanId      String   @map("account_plan_id") @db.Uuid
  accountCode        String   @map("account_code")
  accountCodeDisplay String?  @map("account_code_display")
  accountName        String   @map("account_name")
  accountType        String?  @map("account_type")
  parentAccountCode  String?  @map("parent_account_code")
  classification     String?
  statementCode      String?  @map("statement_code")
  bpGroup            String?  @map("bp_group")
  ebitdaComponent    String?  @map("ebitda_component")
  canonicalKey       String?  @map("canonical_key")
  dfcClassification  String?  @map("dfc_classification")
  /// Sempre 'normal' — o sinal é sempre calculado pela engine, nunca editado
  /// pelo usuário (ver applySign() em buildFinancialStatements).
  signRule           String   @default("normal") @map("sign_rule")
  statementGroup     String?  @map("statement_group")
  isActive           Boolean  @default(true) @map("is_active")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  accountPlan FinancialAccountPlan @relation(fields: [accountPlanId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([accountPlanId])
  @@index([accountPlanId, accountCode])
  @@map("financial_account_plan_lines")
}

/// Uma análise/diagnóstico financeiro (o objeto raiz da jornada).
model FinancialDiagnosis {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  groupId       String?   @map("group_id") @db.Uuid
  companyId     String?   @map("company_id") @db.Uuid
  unitId        String?   @map("unit_id") @db.Uuid
  scopeLevel    String?   @map("scope_level")
  analysisType  String    @default("individual") @map("analysis_type")
  title         String
  status        String    @default("draft")
  firstPeriod   String?   @map("first_period")
  lastPeriod    String?   @map("last_period")
  periodicidade String?
  accountPlanId String?   @map("account_plan_id") @db.Uuid
  notes         String?
  dataBaseAbertura   DateTime? @map("data_base_abertura")
  dataBaseFechamento DateTime? @map("data_base_fechamento")
  monthsCount        Int?      @map("months_count")
  presentingEntityId String?   @map("presenting_entity_id") @db.Uuid
  parentEntityId     String?   @map("parent_entity_id") @db.Uuid
  currentUploadId    String?   @map("current_upload_id") @db.Uuid
  currentProcessingSnapshotId String? @map("current_processing_snapshot_id") @db.Uuid
  /// Preenchidos por checkFinancialDiagnosisIntegrity (fase 2) — já
  /// existem aqui para não exigir outra migration quando essa fase chegar.
  integrityStatus        String?   @map("integrity_status")
  integrityBlockingCount Int?      @map("integrity_blocking_count")
  integrityWarningCount  Int?      @map("integrity_warning_count")
  integrityCheckedAt     DateTime? @map("integrity_checked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  group       Group?                @relation(fields: [groupId], references: [id])
  company     Company?              @relation(fields: [companyId], references: [id])
  unit        OperationalUnit?      @relation(fields: [unitId], references: [id])
  accountPlan FinancialAccountPlan? @relation(fields: [accountPlanId], references: [id])

  uploads           FinancialUpload[]
  journeyPositions  FinancialJourneyPosition[]
  processingRuns    FinancialProcessingRun[]
  validationResults FinancialValidationResult[]
  statementLines       FinancialStatementLine[]
  indicatorSnapshots   FinancialIndicatorSnapshot[]
  trialBalanceLines    FinancialTrialBalanceLine[]
  mappingResolutions   FinancialMappingResolution[]
  dfcCompositionLines  FinancialDfcCompositionLine[]
  dfcManualAdjustments FinancialDfcManualAdjustment[]
  dfcClassificationOverrides FinancialDfcClassificationOverride[]
  findings            FinancialFinding[]
  recommendations     FinancialRecommendation[]
  actionProposals     FinancialActionProposal[]
  reportVersions      FinancialReportVersion[]

  @@index([tenantId])
  @@index([groupId])
  @@index([companyId])
  @@index([unitId])
  @@map("financial_diagnoses")
}

/// Upload de balancete/arquivo-fonte vinculado a uma análise.
model FinancialUpload {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  financialDiagnosisId  String   @map("financial_diagnosis_id") @db.Uuid
  fileName              String   @map("file_name")
  /// Chave do objeto no MinIO (bucket financial-uploads), não uma URL pública.
  fileUrl               String   @map("file_url")
  versionNumber         Int?     @map("version_number")
  uploadStatus          String   @default("pending") @map("upload_status")
  isCurrent             Boolean  @default(true) @map("is_current")
  sourceEntityId        String?  @map("source_entity_id") @db.Uuid
  sourceEntityType      String?  @map("source_entity_type")
  sourceEntityName      String?  @map("source_entity_name")
  sourcePeriod          String?  @map("source_period")
  sourceKey             String?  @map("source_key")
  inputChecksum         String?  @map("input_checksum")
  replacementStatus     String?  @map("replacement_status")
  notes                 String?
  validationSummary          Json?     @map("validation_summary")
  currentValidationRunId     String?   @map("current_validation_run_id") @db.Uuid
  currentValidationChecksum  String?   @map("current_validation_checksum")
  validatedAt                 DateTime? @map("validated_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  financialDiagnosis FinancialDiagnosis @relation(fields: [financialDiagnosisId], references: [id], onDelete: Cascade)

  processingRuns    FinancialProcessingRun[]
  validationResults FinancialValidationResult[]
  statementLines      FinancialStatementLine[]
  trialBalanceLines   FinancialTrialBalanceLine[]
  mappingResolutions  FinancialMappingResolution[]

  @@index([tenantId])
  @@index([financialDiagnosisId])
  @@map("financial_uploads")
}

/// Última etapa da jornada que cada usuário selecionou, por análise
/// (preferência de UI — não afeta o que está de fato liberado).
model FinancialJourneyPosition {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  financialDiagnosisId  String   @map("financial_diagnosis_id") @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  userEmail             String   @map("user_email")
  step                  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  financialDiagnosis FinancialDiagnosis @relation(fields: [financialDiagnosisId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id])

  @@unique([financialDiagnosisId, userId])
  @@index([tenantId])
  @@map("financial_journey_positions")
}

/// Registro de execução de uma operação assíncrona/idempotente da engine
/// financeira (hoje: validate_upload; fases futuras adicionam outros
/// operationType, ex: build_statements).
model FinancialProcessingRun {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  financialDiagnosisId  String    @map("financial_diagnosis_id") @db.Uuid
  financialUploadId     String?   @map("financial_upload_id") @db.Uuid
  operationType         String    @map("operation_type")
  operationKey          String    @map("operation_key")
  status                String    @default("running")
  startedAt             DateTime  @default(now()) @map("started_at")
  completedAt           DateTime? @map("completed_at")
  triggeredBy           String?   @map("triggered_by")
  sourceEntityId        String?   @map("source_entity_id") @db.Uuid
  sourcePeriod           String?   @map("source_period")
  inputChecksum           String?   @map("input_checksum")
  resultSummary            Json?     @map("result_summary")
  cleanupPending           Boolean   @default(false) @map("cleanup_pending")
  errorDetails             Json?     @map("error_details")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  financialDiagnosis FinancialDiagnosis  @relation(fields: [financialDiagnosisId], references: [id], onDelete: Cascade)
  financialUpload    FinancialUpload?    @relation(fields: [financialUploadId], references: [id])

  validationResults FinancialValidationResult[]
  statementLines      FinancialStatementLine[]
  indicatorSnapshots  FinancialIndicatorSnapshot[]
  trialBalanceLines   FinancialTrialBalanceLine[]
  mappingResolutions  FinancialMappingResolution[]
  dfcCompositionLines FinancialDfcCompositionLine[]

  @@index([tenantId])
  @@index([financialDiagnosisId])
  @@index([operationKey])
  @@map("financial_processing_runs")
}

/// Achado individual de validação de um upload (candidate → active →
/// superseded/invalid — máquina de estados de publicação em duas fases).
model FinancialValidationResult {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  financialDiagnosisId  String    @map("financial_diagnosis_id") @db.Uuid
  financialUploadId     String    @map("financial_upload_id") @db.Uuid
  processingRunId       String    @map("processing_run_id") @db.Uuid
  publicationStatus     String    @default("candidate") @map("publication_status")
  severity              String
  category              String?
  code                  String?
  title                 String?
  message               String?
  sheetName             String?   @map("sheet_name")
  rowRef                String?   @map("row_ref")
  blocking              Boolean   @default(false)
  publishedAt           DateTime? @map("published_at")
  supersededAt          DateTime? @map("superseded_at")
  invalidatedAt         DateTime? @map("invalidated_at")
  invalidationReason    String?   @map("invalidation_reason")
  createdAt             DateTime  @default(now()) @map("created_at")

  tenant             Tenant                 @relation(fields: [tenantId], references: [id])
  financialDiagnosis FinancialDiagnosis     @relation(fields: [financialDiagnosisId], references: [id], onDelete: Cascade)
  financialUpload    FinancialUpload        @relation(fields: [financialUploadId], references: [id], onDelete: Cascade)
  processingRun      FinancialProcessingRun @relation(fields: [processingRunId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([financialDiagnosisId])
  @@index([financialUploadId])
  @@index([processingRunId])
  @@index([publicationStatus])
  @@map("financial_validation_results")
}

// ── Fase 2: motor de montagem de demonstrações (BP/DRE/DFC) ──────────────
//
// No Base44 original, cada build passa por uma máquina de estados manual
// (candidate → committing → active/superseded/invalid) com rollback de
// compensação escrito à mão, apoiada por uma tabela extra de "snapshot"
// imutável (FinancialProcessingSnapshot) e um ponteiro duplo por entidade
// (FinancialSourceOutputHead). Como no Postgres já temos transações reais,
// essa complexidade foi deliberadamente simplificada: cada build roda numa
// única transação (via PrismaService.withTenantContext), que já garante
// atomicidade sem precisar de compensação manual nem de uma tabela de
// snapshot separada. O FinancialProcessingRun já existente faz o papel de
// "run" e também de "snapshot" (seu id é gravado em
// FinancialDiagnosis.currentProcessingSnapshotId como o build atual válido).
// Fase 2 cobre só analysisType='individual' — as tabelas de preparação
// multi-empresa (FinancialPreparationRun, PreparedFinancialDatasetLine,
// FinancialAnalysisScopeEntity, FinancialConsolidationEntry) ficam para uma
// fase futura de consolidação.

/// Uma linha de BP, DRE ou DFC por período×rubrica_canônica. Tabela de saída
/// principal — o que as telas de demonstrações renderizam.
model FinancialStatementLine {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  financialDiagnosisId  String    @map("financial_diagnosis_id") @db.Uuid
  financialUploadId     String?   @map("financial_upload_id") @db.Uuid
  processingRunId       String    @map("processing_run_id") @db.Uuid
  entityCode            String?   @map("entity_code")
  period                String
  columnKey             String?   @map("column_key")
  columnLabel           String?   @map("column_label")
  periodType            String?   @map("period_type")
  statementCode         String    @map("statement_code")
  statementFamily       String?   @map("statement_family")
  groupLabel            String?   @map("group_label")
  rubricLabel           String?   @map("rubric_label")
  canonicalKey          String    @map("canonical_key")
  lineType              String    @map("line_type")
  displayOrder          Int?      @map("display_order")
  noteReference         String?   @map("note_reference")
  value                 Decimal   @db.Decimal(20, 4)
  datasetScope          String    @default("individual") @map("dataset_scope")
  reportingEntityId     String?   @map("reporting_entity_id") @db.Uuid
  publicationStatus     String    @default("candidate") @map("publication_status")
  publishedAt           DateTime? @map("published_at")
  supersededAt          DateTime? @map("superseded_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  tenant             Tenant                 @relation(fields: [tenantId], references: [id])
  financialDiagnosis FinancialDiagnosis     @relation(fields: [financialDiagnosisId], references: [id], onDelete: Cascade)
  financialUpload    FinancialUpload?       @relation(fields: [financialUploadId], references: [id], onDelete: SetNull)
  processingRun      FinancialProcessingRun @relation(fields: [processingRunId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([financialDiagnosisId, processingRunId, publicationStatus])
  @@index([financialDiagnosisId, period, canonicalKey])
  @@map("financial_statement_lines")
}

/// Um valor de indicador/índice financeiro por período×indicador.
model FinancialIndicatorSnapshot {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  financialDiagnosisId  String    @map("financial_diagnosis_id") @db.Uuid
  processingRunId       String    @map("processing_run_id") @db.Uuid
  entityCode            String?   @map("entity_code")
  period                String
  columnKey             String?   @map("column_key")
  columnLabel           String?   @map("column_label")
  periodType            String?   @map("period_type")
  indicatorCode         String    @map("indicator_code")
  value                 Decimal?  @db.Decimal(20, 6)
  previousValue         Decimal?  @map("previous_value") @db.Decimal(20, 6)
  variationValue        Decimal?  @map("variation_value") @db.Decimal(20, 6)
  variationPercent      Decimal?  @map("variation_percent") @db.Decimal(20, 6)
  signal                String?
  severity              String?
  confidenceLevel       String?   @map("confidence_level")
  validationCode        String?   @map("validation_code")
  formula               String?
  numerator              String?
  denominator            String?
  canonicalSources       Json?    @map("canonical_sources")
  datasetScope          String    @default("individual") @map("dataset_scope")
  reportingEntityId     String?   @map("reporting_entity_id") @db.Uuid
  publicationStatus     String    @default("candidate") @map("publication_status")
  publishedAt           DateTime? @map("published_at")
  supersededAt          DateTime? @map("superseded_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  tenant             Tenant                 @relation(fields: [tenantId], references: [id])
  financialDiagnosis FinancialDiagnosis     @relation(fields: [financialDiagnosisId], references: [id], onDelete: Cascade)
  processingRun      FinancialProcessingRun @relation(fields: [processingRunId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([financialDiagnosisId, publicationStatus])
  @@index([financialDiagnosisId, indicatorCode])
  @@map("financial_indicator_snapshots")
}

/// Linha crua do balancete (uma por conta×período), como veio do Excel —
/// sem agregação, mantida para rastreabilidade/auditoria.
model FinancialTrialBalanceLine {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  financialDiagnosisId  String   @map("financial_diagnosis_id") @db.Uuid
  financialUploadId     String   @map("financial_upload_id") @db.Uuid
  processingRunId       String   @map("processing_run_id") @db.Uuid
  accountCode           String   @map("account_code")
  accountName           String?  @map("account_name")
  period                String
  value                 Decimal  @db.Decimal(20, 4)
  sourceSheet           String?  @map("source_sheet")
  sourceRow             Int?     @map("source_row")
  publicationStatus     String   @default("candidate") @map("publication_status")
  createdAt             DateTime @default(now()) @map("created_at")

  tenant             Tenant                 @relation(fields: [tenantId], references: [id])
  financialDiagnosis FinancialDiagnosis     @relation(fields: [financialDiagnosisId], references: [id], onDelete: Cascade)
  financialUpload    FinancialUpload        @relation(fields: [financialUploadId], references: [id], onDelete: Cascade)
  processingRun      FinancialProcessingRun @relation(fields: [processingRunId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([financialDiagnosisId, publicationStatus])
  @@map("financial_trial_balance_lines")
}

/// Uma decisão de mapeamento conta→rubrica_canônica por conta encontrada no
/// balancete (de onde veio: plano de contas, planilha, ou não mapeada).
model FinancialMappingResolution {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  financialDiagnosisId  String   @map("financial_diagnosis_id") @db.Uuid
  financialUploadId     String   @map("financial_upload_id") @db.Uuid
  processingRunId       String   @map("processing_run_id") @db.Uuid
  accountCode           String   @map("account_code")
  canonicalKey          String?  @map("canonical_key")
  mappingSource         String   @map("mapping_source")
  blockingIssue         Boolean  @default(false) @map("blocking_issue")
  resolvedConfidence    String?  @map("resolved_confidence")
  publicationStatus     String   @default("candidate") @map("publication_status")
  createdAt             DateTime @default(now()) @map("created_at")

  tenant             Tenant                 @relation(fields: [tenantId], references: [id])
  financialDiagnosis FinancialDiagnosis     @relation(fields: [financialDiagnosisId], references: [id], onDelete: Cascade)
  financialUpload    FinancialUpload        @relation(fields: [financialUploadId], references: [id], onDelete: Cascade)
  processingRun      FinancialProcessingRun @relation(fields: [processingRunId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([financialDiagnosisId, publicationStatus])
  @@map("financial_mapping_resolutions")
}

/// Decomposição em "baldes" de DFC (operacional/investimento/financiamento)
/// de cada rubrica de BP entre dois períodos consecutivos — o que
/// explica/justifica cada número da DFC indireta.
model FinancialDfcCompositionLine {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  financialDiagnosisId  String   @map("financial_diagnosis_id") @db.Uuid
  processingRunId       String   @map("processing_run_id") @db.Uuid
  period                String
  columnKey             String?  @map("column_key")
  rubricKey              String  @map("rubric_key")
  rubricLabel            String? @map("rubric_label")
  canonicalKey            String? @map("canonical_key")
  bucket                 String
  bucketSource            String? @map("bucket_source")
  previousValue           Decimal? @map("previous_value") @db.Decimal(20, 4)
  currentValue            Decimal? @map("current_value") @db.Decimal(20, 4)
  delta                   Decimal? @db.Decimal(20, 4)
  impactOnDfc              Decimal? @map("impact_on_dfc") @db.Decimal(20, 4)
  datasetScope            String  @default("individual") @map("dataset_scope")
  reportingEntityId        String? @map("reporting_entity_id") @db.Uuid
  publicationStatus        String  @default("candidate") @map("publication_status")
  createdAt                DateTime @default(now()) @map("created_at")

  tenant             Tenant                 @relation(fields: [tenantId], references: [id])
  financialDiagnosis FinancialDiagnosis     @relation(fields: [financialDiagnosisId], references: [id], onDelete: Cascade)
  processingRun      FinancialProcessingRun @relation(fields: [processingRunId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([financialDiagnosisId, publicationStatus])
  @@map("financial_dfc_composition_lines")
}

/// Ajuste manual de DFC informado pelo usuário (ex: um lançamento que o
/// método indireto não capturaria sozinho). Persiste entre builds — é lido
/// e somado à atividade correspondente a cada rebuild.
model FinancialDfcManualAdjustment {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  financialDiagnosisId  String   @map("financial_diagnosis_id") @db.Uuid
  financialUploadId     String?  @map("financial_upload_id") @db.Uuid
  activity              String
  label                 String?
  value                 Decimal  @db.Decimal(20, 4)
  period                String
  columnKey             String?  @map("column_key")
  adjustmentType        String?  @map("adjustment_type")
  justification         String?
  notes                 String?
  createdBy             String?  @map("created_by")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  financialDiagnosis FinancialDiagnosis @relation(fields: [financialDiagnosisId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([financialDiagnosisId])
  @@map("financial_dfc_manual_adjustments")
}

/// Override manual do "balde" de DFC de uma rubrica canônica (sobrepõe o
/// dfc_treatment do registro canônico / da inferência por texto).
model FinancialDfcClassificationOverride {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  financialDiagnosisId  String   @map("financial_diagnosis_id") @db.Uuid
  canonicalKey          String   @map("canonical_key")
  manualBucket          String   @map("manual_bucket")
  status                String   @default("active")
  createdBy             String?  @map("created_by")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  financialDiagnosis FinancialDiagnosis @relation(fields: [financialDiagnosisId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([financialDiagnosisId])
  @@map("financial_dfc_classification_overrides")
}

// ── Relatório da Análise Financeira: achados, recomendações, propostas de
// ação e versionamento de PDF ("Frente B" financeira). Promove pro Postgres
// o que no base44 original (base44/entities/FinancialFinding.jsonc,
// FinancialRecommendation.jsonc, FinancialActionProposal.jsonc) vivia como
// entidade real, mas que na porta local ficou só como mock em localStorage
// (ver ActionTask.financialDiagnosisId/financialFindingId e
// ActionRecommendation homônimos — campos já reservados sem FK justamente
// por essa lacuna). A partir daqui esses campos passam a apontar pra dado
// real; ActionTask continua sem FK formal pra manter simetria com o resto
// do schema, mas o valor gravado agora é um FinancialFinding.id de verdade. ──

/// Achado (automático ou manual) sobre um diagnóstico financeiro — detectado
/// por limiar/variação (origin=auto_interpretation, motor em
/// FinancialInsightService, porta de generateFinancialInterpretations) ou
/// registrado à mão pelo consultor (origin=manual). reportInclusionStatus é
/// o estado de curadoria para fins do Relatório da Análise (distinto de
/// status/action_plan_status, que rastreiam o ciclo achado→recomendação→
/// tarefa) — um achado pode estar convertido em tarefa e, independentemente,
/// aprovado/excluído do relatório.
model FinancialFinding {
  id                   String  @id @default(uuid()) @db.Uuid
  tenantId             String  @map("tenant_id") @db.Uuid
  financialDiagnosisId String  @map("financial_diagnosis_id") @db.Uuid
  groupId              String? @map("group_id") @db.Uuid
  companyId            String? @map("company_id") @db.Uuid
  unitId               String? @map("unit_id") @db.Uuid

  title       String
  description String?
  severity    String @default("medium")
  findingType String  @map("finding_type")

  financialIndicator String? @map("financial_indicator")
  period             String?
  comparisonPeriod   String? @map("comparison_period")
  findingScope       String  @default("period_snapshot") @map("finding_scope")

  financialUploadId String? @map("financial_upload_id") @db.Uuid
  findingKey        String  @map("finding_key")
  sourceType        String  @map("source_type")
  sourceRefId       String? @map("source_ref_id")
  origin            String  @default("manual")
  confidenceLevel   String  @default("medium") @map("confidence_level")
  status            String  @default("open")

  /// Evidência numérica citada no achado — array de {label, value, period,
  /// formatted} usado tanto pela seção 3 (Insights) quanto pela exportação
  /// em PDF, exigência da spec de "fundamentação numérica obrigatória".
  evidenceNumeric Json? @map("evidence_numeric")

  /// Classificação de apresentação no relatório (distinta de `severity`,
  /// que é o sinal técnico do motor de detecção).
  classification         String? // critico | atencao | oportunidade | informativo
  interpretation          String?
  potentialImpact         String? @map("potential_impact")
  investigationQuestion   String? @map("investigation_question")
  reportInclusionStatus   String  @default("candidate") @map("report_inclusion_status") // candidate | approved | edited | excluded | internal_only
  reportInclusionEditedText String? @map("report_inclusion_edited_text")
  lastReportVersionId     String? @map("last_report_version_id") @db.Uuid

  actionPlanStatus     String    @default("not_sent") @map("action_plan_status")
  actionRecommendationId String? @map("action_recommendation_id") @db.Uuid
  actionTaskId         String?   @map("action_task_id") @db.Uuid
  actionPlanId         String?   @map("action_plan_id") @db.Uuid
  sentToActionPlanAt   DateTime? @map("sent_to_action_plan_at")
  sentToActionPlanBy   String?   @map("sent_to_action_plan_by")
  convertedToTaskAt    DateTime? @map("converted_to_task_at")
  convertedToTaskBy    String?   @map("converted_to_task_by")
  rejectedReason       String?   @map("rejected_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  financialDiagnosis FinancialDiagnosis @relation(fields: [financialDiagnosisId], references: [id], onDelete: Cascade)

  recommendations FinancialRecommendation[]

  @@index([tenantId])
  @@index([financialDiagnosisId, origin])
  @@index([financialDiagnosisId, findingKey])
  @@map("financial_findings")
}

/// Recomendação técnica derivada de um FinancialFinding (ou manual) — texto
/// editável pelo consultor antes de virar uma FinancialActionProposal.
model FinancialRecommendation {
  id                   String  @id @default(uuid()) @db.Uuid
  tenantId             String  @map("tenant_id") @db.Uuid
  financialDiagnosisId String  @map("financial_diagnosis_id") @db.Uuid
  financialFindingId   String? @map("financial_finding_id") @db.Uuid

  title             String
  diagnosticThesis  String? @map("diagnostic_thesis")
  probableCause     String? @map("probable_cause")
  suggestedAction   String? @map("suggested_action")
  expectedImpact    String? @map("expected_impact")
  priority          String  @default("media") // critica | alta | media | baixa
  editableText      String? @map("editable_text")
  consultantComment String? @map("consultant_comment")

  /// Ligado ao envio ao Plano de Ação (convertRecommendation/unconvertToTask)
  /// — NÃO é a aprovação de inclusão no relatório, ver reportInclusionStatus.
  isApproved Boolean   @default(false) @map("is_approved")
  approvedAt DateTime? @map("approved_at")
  approvedBy String?   @map("approved_by")

  /// Curadoria de inclusão na seção "4. Recomendações avulsas" do relatório
  /// — mesmo padrão de FinancialFinding.reportInclusionStatus, mas
  /// independente dele: uma recomendação pode ser aprovada pro relatório
  /// mesmo que o achado-pai não esteja (ou vice-versa).
  reportInclusionStatus String @default("candidate") @map("report_inclusion_status") // candidate | approved | edited | excluded | internal_only

  relatedIndicatorCodes String[] @map("related_indicator_codes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  financialDiagnosis FinancialDiagnosis @relation(fields: [financialDiagnosisId], references: [id], onDelete: Cascade)
  finding            FinancialFinding?  @relation(fields: [financialFindingId], references: [id], onDelete: SetNull)

  actionProposals FinancialActionProposal[]

  @@index([tenantId])
  @@index([financialDiagnosisId])
  @@map("financial_recommendations")
}

/// Proposta de ação exportável — a última curadoria antes de virar ActionTask
/// no Plano de Ação central do grupo (ver FinancialInsightService.convert,
/// porta de convertFinancialRecommendation).
model FinancialActionProposal {
  id                       String  @id @default(uuid()) @db.Uuid
  tenantId                 String  @map("tenant_id") @db.Uuid
  financialDiagnosisId     String  @map("financial_diagnosis_id") @db.Uuid
  financialRecommendationId String? @map("financial_recommendation_id") @db.Uuid

  title       String
  description String?
  priority    String  @default("media")
  status      String  @default("proposed") // proposed | approved | exported | rejected

  exportedToFal    Boolean   @default(false) @map("exported_to_fal")
  falActionPlanId  String?   @map("fal_action_plan_id") @db.Uuid
  falActionTaskId  String?   @map("fal_action_task_id") @db.Uuid
  exportedAt       DateTime? @map("exported_at")
  consultantAdjustment String? @map("consultant_adjustment")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant             Tenant                   @relation(fields: [tenantId], references: [id])
  financialDiagnosis FinancialDiagnosis       @relation(fields: [financialDiagnosisId], references: [id], onDelete: Cascade)
  recommendation     FinancialRecommendation? @relation(fields: [financialRecommendationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([financialDiagnosisId])
  @@index([financialRecommendationId])
  @@map("financial_action_proposals")
}

/// Versão imutável do "Relatório da Análise" (PDF) de um diagnóstico
/// financeiro — mesmo padrão de AssessmentReportVersion (snapshot congelado,
/// nunca sobrescrito; cada geração ou finalização nasce uma linha nova).
model FinancialReportVersion {
  id                   String  @id @default(uuid()) @db.Uuid
  tenantId             String  @map("tenant_id") @db.Uuid
  financialDiagnosisId String  @map("financial_diagnosis_id") @db.Uuid

  versionNumber        Int      @default(1) @map("version_number")
  status               String   @default("draft") // draft | generated | in_review | final | outdated
  baseDatePeriod       String?  @map("base_date_period")
  comparativePeriods   String[] @map("comparative_periods")

  payloadSnapshot       Json?   @map("payload_snapshot")
  payloadChecksum       String? @map("payload_checksum")
  /// Edições manuais de texto (por sectionKey) que sobrevivem a uma
  /// regeneração — só são descartadas se o usuário confirmar explicitamente.
  reviewedTextOverrides Json?   @map("reviewed_text_overrides")

  pdfStatus      String?   @map("pdf_status")
  pdfFileUrl     String?   @map("pdf_file_url")
  pdfChecksum    String?   @map("pdf_checksum")
  pdfGeneratedAt DateTime? @map("pdf_generated_at")
  pdfPageCount   Int?      @map("pdf_page_count")
  pdfFileSize    Int?      @map("pdf_file_size")
  pdfStorageKey  String?   @map("pdf_storage_key")
  pdfError       String?   @map("pdf_error")
  watermarkDraft Boolean   @default(true) @map("watermark_draft")

  generatedAt DateTime? @map("generated_at")
  generatedBy String?   @map("generated_by")
  finalizedAt DateTime? @map("finalized_at")
  finalizedBy String?   @map("finalized_by")
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  financialDiagnosis FinancialDiagnosis @relation(fields: [financialDiagnosisId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([financialDiagnosisId, status])
  @@map("financial_report_versions")
}

// ── Marco 2: Motor de scoring 8D (diagnóstico, prioridade, inteligência, MFIS, agregados) ──

/// Estado da esteira pós-questionário (diagnóstico → prioridades →
/// inteligência → plano de ação → simulação → relatório) — um registro por
/// assessment. Espelha base44/getAssessmentFlow + onFalResponseChange.
model AssessmentFlowState {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  assessmentId String  @unique @map("assessment_id") @db.Uuid

  flowVersion            Int @default(1) @map("flow_version")
  sourceResponseVersion  Int @default(0) @map("source_response_version")

  diagnosticStatus   String @default("not_started") @map("diagnostic_status")
  prioritiesStatus   String @default("not_started") @map("priorities_status")
  intelligenceStatus String @default("not_started") @map("intelligence_status")
  actionPlanStatus   String @default("not_started") @map("action_plan_status")
  simulationStatus   String @default("not_started") @map("simulation_status")
  reportStatus       String @default("not_started") @map("report_status")

  diagnosticGeneratedAt   DateTime? @map("diagnostic_generated_at")
  prioritiesGeneratedAt   DateTime? @map("priorities_generated_at")
  intelligenceGeneratedAt DateTime? @map("intelligence_generated_at")
  actionPlanGeneratedAt   DateTime? @map("action_plan_generated_at")
  simulationGeneratedAt   DateTime? @map("simulation_generated_at")
  reportGeneratedAt       DateTime? @map("report_generated_at")

  snapshotId             String? @map("snapshot_id") @db.Uuid
  prioritiesSnapshotId   String? @map("priorities_snapshot_id") @db.Uuid
  intelligenceSnapshotId String? @map("intelligence_snapshot_id") @db.Uuid
  actionPlanId           String? @map("action_plan_id") @db.Uuid
  simulationId           String? @map("simulation_id") @db.Uuid
  reportId               String? @map("report_id") @db.Uuid

  /// null = nenhuma etapa está desatualizada.
  staleFromStep    String? @map("stale_from_step")
  lastErrorStep    String? @map("last_error_step")
  lastErrorMessage String? @map("last_error_message")
  lastRunMode      String? @map("last_run_mode")
  nextBestStep     String? @map("next_best_step")
  updatedBy        String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("assessment_flow_states")
}

/// Snapshot do motor de diagnóstico FAL — um registro por cálculo
/// (computeFalDiagnostic cria; computeFalPriority/computeClusterIntelligence
/// atualizam o mais recente com prioridades/inteligência). Estruturas
/// profundas (dimension_scores, cluster_analysis etc.) ficam em JSON —
/// são a árvore de cálculo inteira, não fazem sentido como colunas.
model FalDiagnosticSnapshot {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  assessmentId String  @map("assessment_id") @db.Uuid
  cycleId      String? @map("cycle_id")
  targetType   String? @map("target_type")
  targetId     String? @map("target_id") @db.Uuid

  computedAt DateTime @default(now()) @map("computed_at")
  computedBy String?  @map("computed_by")

  questionSet           String[] @map("question_set")
  dimensionScores       Json     @map("dimension_scores")
  overallScore          Decimal  @map("overall_score") @db.Decimal(6, 2)
  overallLevel          String   @map("overall_level")
  radarPoints           Json     @map("radar_points")
  gapsTop               Json     @map("gaps_top")
  sectorSnapshot        String[] @map("sector_snapshot")
  activeDimensions      String[] @map("active_dimensions")
  dimensionRiskSummary  Json     @map("dimension_risk_summary")
  maturityIndex         Int      @map("maturity_index")
  totalEvolution        Decimal? @map("total_evolution") @db.Decimal(6, 2)
  criticalClustersCount Int      @default(0) @map("critical_clusters_count")
  totalClustersCount    Int      @default(0) @map("total_clusters_count")
  actionExecutionRate   Int?     @map("action_execution_rate")
  impactPotential       Decimal? @map("impact_potential") @db.Decimal(6, 2)
  valueLeverSummary     Json?    @map("value_lever_summary")
  methodologyLog        Json     @map("methodology_log")

  /// Preenchido por computeFalPriority.
  clustersCriticos        Json?     @map("clusters_criticos")
  clustersAltaPrioridade  Json?     @map("clusters_alta_prioridade")
  clustersMediaPrioridade Json?     @map("clusters_media_prioridade")
  clustersBaixaPrioridade Json?     @map("clusters_baixa_prioridade")
  priorityComputedAt      DateTime? @map("priority_computed_at")
  priorityComputedBy      String?   @map("priority_computed_by")

  /// Preenchido por computeClusterIntelligence.
  clusterAnalysis            Json?     @map("cluster_analysis")
  intelligenceComputedAt     DateTime? @map("intelligence_computed_at")
  intelligenceBenchmarkGroup String?   @map("intelligence_benchmark_group")

  /// Preenchido por publishFalAssessment — publicar cria/atualiza uma linha
  /// separada com status='published' (upsert por tenant+assessment+cycle),
  /// mantendo o(s) snapshot(s) 'draft' intactos como histórico de cálculo.
  status           String    @default("draft")
  publishedAt      DateTime? @map("published_at")
  publishedBy      String?   @map("published_by")
  answersCoverage  Decimal?  @map("answers_coverage") @db.Decimal(4, 2)
  sourceSnapshotId String?   @map("source_snapshot_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([assessmentId, computedAt])
  @@map("fal_diagnostic_snapshots")
}

/// Um dos 11 cruzamentos MFIS™ calculados para um assessment — upsert por
/// (assessment_id, crossing_key). Ver computeMfisAnalysis.
model SystemicCrossingAnalysis {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  assessmentId String @map("assessment_id") @db.Uuid

  computedAt DateTime @default(now()) @map("computed_at")
  computedBy String?  @map("computed_by")

  crossingKey   String @map("crossing_key")
  crossingLabel String @map("crossing_label")
  crossingType  String @map("crossing_type")

  dimensionAKey   String @map("dimension_a_key")
  dimensionALabel String @map("dimension_a_label")
  dimensionBKey   String @map("dimension_b_key")
  dimensionBLabel String @map("dimension_b_label")

  dimensionAScoreRaw Decimal  @map("dimension_a_score_raw") @db.Decimal(6, 2)
  dimensionBScoreRaw Decimal  @map("dimension_b_score_raw") @db.Decimal(6, 2)
  mqeScoreRaw        Decimal? @map("mqe_score_raw") @db.Decimal(6, 2)
  hasMqeData         Boolean  @default(false) @map("has_mqe_data")

  crossScoreBaseRaw Decimal @map("cross_score_base_raw") @db.Decimal(6, 2)
  crossWeight       Decimal @map("cross_weight") @db.Decimal(6, 2)
  crossScoreFinal   Decimal @map("cross_score_final") @db.Decimal(6, 2)

  tensionLevel String  @map("tension_level")
  tensionRank  Int?    @map("tension_rank")
  isFragile    Boolean @default(false) @map("is_fragile")
  isCritical   Boolean @default(false) @map("is_critical")

  interpretationText String? @map("interpretation_text")
  riskSummary        String? @map("risk_summary")
  recommendedFocus   String? @map("recommended_focus")
  systemicWeight     Decimal? @map("systemic_weight") @db.Decimal(6, 2)

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, crossingKey])
  @@index([tenantId])
  @@map("systemic_crossing_analyses")
}

/// Impacto sistêmico agregado de uma dimensão (soma dos cruzamentos em que
