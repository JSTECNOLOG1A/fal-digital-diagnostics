/// Benchmark de mercado por cluster/grupo setorial — biblioteca global.
/// NOTA: a planilha de benchmark importada nesta sessão (falBenchmark.json)
/// usa um formato diferente (sector/benchmark_value/benchmark_description,
/// sem percentis) e por isso NÃO foi semeada aqui — precisa ser remapeada/
/// enriquecida com avg/p75/p90 reais antes de alimentar esta tabela, senão
/// benchmarkPosition() em computeClusterIntelligence quebra silenciosamente
/// (percentil null vira 0 na comparação e classifica tudo como "top10").
model FalBenchmark {
  id               String  @id @default(uuid()) @db.Uuid
  dimensionKey     String? @map("dimension_key")
  subdimensionKey  String? @map("subdimension_key")
  clusterKey       String  @map("cluster_key")
  benchmarkGroup   String  @map("benchmark_group")
  avgScore         Decimal @map("avg_score") @db.Decimal(6, 2)
  medianScore      Decimal? @map("median_score") @db.Decimal(6, 2)
  p75Score         Decimal? @map("p75_score") @db.Decimal(6, 2)
  p90Score         Decimal? @map("p90_score") @db.Decimal(6, 2)
  sampleSize       Int?    @map("sample_size")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([clusterKey, benchmarkGroup])
  @@map("fal_benchmarks")
}

// ── Marco 3: Plano de Ação (Execução & Impacto) ──
//
// base44/functions/generateActionPlan usava um estado manual "candidate/
// active/invalid" com snapshot+rollback pra simular transação atômica
// (a API de entidades do base44 não garante atomicidade entre múltiplos
// creates/updates). No Postgres real, um único `prisma.$transaction` dá
// essa garantia de graça — por isso o port aqui NÃO replica a máquina de
// estados/rollback: ActionPlanGenerationOperation vira um log de auditoria
// simples (sucesso/falha), não um ledger de commit. Também não portamos
// resolveFinancialLineage (DiagnosticLink/FinancialProcessingSnapshot/
// FinancialSourceOutputHead não existem no Postgres — Financial "Frente B"
// nunca foi migrada) nem FalInsightSnapshot/computeInsights/
// FalRootCauseCatalog (motor legado pré-FAL, já excluído do escopo geral
// da migração) — esses dois só enriqueciam o plano com metadado opcional,
// nunca decidiam quais tarefas são geradas.

/// Perguntas específicas (FalQuestion) com score baixo disparam uma ação
/// operacional própria — biblioteca global, ver generateActionPlan passo 9.
model FalQuestionActionLibrary {
  id                 String   @id @default(uuid()) @db.Uuid
  questionId         String   @map("question_id")
  dimensionKey       String?  @map("dimension_key")
  subdimensionKey    String?  @map("subdimension_key")
  clusterKey         String?  @map("cluster_key")
  sectorGroup        String   @default("geral") @map("sector_group")
  triggerScoreMax    Decimal  @default(2) @map("trigger_score_max") @db.Decimal(4, 2)
  actionType         String   @default("implantacao") @map("action_type")
  actionTitle        String   @map("action_title")
  actionDescription  String?  @map("action_description")
  howToExecute       String?  @map("how_to_execute")
  expectedEvidence   String?  @map("expected_evidence")
  frequency          String?  @default("once")
  reasonTemplate     String?  @map("reason_template")
  impactLevel        Int      @default(3) @map("impact_level")
  effortLevel        Int      @default(3) @map("effort_level")
  priorityWeight     Decimal? @map("priority_weight") @db.Decimal(4, 2)
  responsibleRole    String?  @map("responsible_role")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([questionId])
  @@index([clusterKey])
  @@map("fal_question_action_library")
}

/// Um plano de ação por (tenant, target) — reidentificado por plan_key.
model ActionPlan {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  /// Opcional a partir do Marco 7 (convergência FAL × Financeiro) — um plano
  /// pode nascer só de um diagnóstico financeiro (ainda não migrado, ver
  /// FinancialFinding no comentário de ActionRecommendation) sem nenhum
  /// Assessment 8D por trás. O ancoramento real do plano passa a ser
  /// groupId/companyId/unitId — pelo menos um deles é obrigatório (CHECK na
  /// migration). assessmentId vira só "a origem 8D, se houver".
  assessmentId String? @map("assessment_id") @db.Uuid
  groupId      String? @map("group_id") @db.Uuid
  companyId    String? @map("company_id") @db.Uuid
  unitId       String? @map("unit_id") @db.Uuid
  cycleId      String? @map("cycle_id")
  targetType   String? @map("target_type")
  targetId     String? @map("target_id") @db.Uuid
  planKey      String  @map("plan_key")

  diagnosticSnapshotId  String? @map("diagnostic_snapshot_id") @db.Uuid
  generationFingerprint String? @map("generation_fingerprint")

  currentRevisionId String?   @map("current_revision_id") @db.Uuid
  lastReviewNumber  Int       @default(0) @map("last_review_number")
  publishedAt       DateTime? @map("published_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by")

  status                     String    @default("draft")
  overallProgressPercentage  Decimal   @default(0) @map("overall_progress_percentage") @db.Decimal(5, 2)
  totalTasks                 Int       @default(0) @map("total_tasks")
  doneTasks                  Int       @default(0) @map("done_tasks")
  blockedTasks                Int      @default(0) @map("blocked_tasks")
  overdueTasks                Int      @default(0) @map("overdue_tasks")
  criticalOpenTasks           Int      @default(0) @map("critical_open_tasks")
  nextDueDate                 DateTime? @map("next_due_date") @db.Date

  generationDiffSummary Json?   @map("generation_diff_summary")
  engineVersion         String? @map("engine_version")
  generationConfig      Json?   @map("generation_config")
  generationSummary     Json?   @map("generation_summary")
  roadmap               Json?

  generatedAt DateTime? @map("generated_at")
  generatedBy String?   @map("generated_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  assessment Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  tasks               ActionTask[]
  recommendations     ActionRecommendation[]
  reviews             ActionPlanReview[]
  generationOperations ActionPlanGenerationOperation[]

  @@unique([tenantId, planKey])
  @@index([tenantId, status])
  @@index([assessmentId])
  @@map("action_plans")
}

model ActionTask {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  planId       String  @map("plan_id") @db.Uuid
  /// Opcional pelo mesmo motivo de ActionPlan.assessmentId — uma tarefa
  /// pode vir de um achado financeiro (financialDiagnosisId/financialFindingId
  /// abaixo) sem nenhum Assessment 8D.
  assessmentId String? @map("assessment_id") @db.Uuid
  targetType   String? @map("target_type")
  targetId     String? @map("target_id") @db.Uuid

  /// Qual motor gerou esta tarefa — 'fal_diagnostic' (padrão, comportamento
  /// atual), 'financial_diagnostic' (Frente B financeira, ainda não migrada)
  /// ou 'manual'. Independente de originType (que descreve o *nível* do
  /// gatilho dentro do motor FAL: cluster/subdimension/dimension/question).
  sourceType           String  @default("fal_diagnostic") @map("source_type")
  /// Sem FK — mesmo motivo do campo homônimo em ActionRecommendation: a
  /// Frente B financeira (FinancialFinding) ainda não foi migrada pro Postgres.
  financialDiagnosisId String? @map("financial_diagnosis_id")
  financialFindingId   String? @map("financial_finding_id")

  dimensionKey    String? @map("dimension_key")
  subdimensionKey String? @map("subdimension_key")
  clusterKey      String? @map("cluster_key")

  /// Entidade avaliada (assessment multi_entity_master) que originou esta
  /// tarefa — só populado pra candidatos operacionais (nível de pergunta),
  /// já que candidatos estratégicos (cluster/dimensão) usam o score já
  /// consolidado entre entidades, não uma resposta de uma entidade só.
  evaluatedEntityId   String? @map("evaluated_entity_id") @db.Uuid
  evaluatedEntityType String? @map("evaluated_entity_type")
  evaluatedEntityName String? @map("evaluated_entity_name")

  taskKey                     String  @map("task_key")
  operationId                 String? @map("operation_id")
  operationStatus             String  @default("active") @map("operation_status")
  operationInvalidatedAt      DateTime? @map("operation_invalidated_at")
  operationInvalidationReason String? @map("operation_invalidation_reason")
  actionLibraryKey            String? @map("action_library_key")

  title       String
  description String?
  horizon     String?
  priority    String?
  actionType  String? @map("action_type")
  taskLayer   String  @default("strategic") @map("task_layer")
  typicalOwner String? @map("typical_owner")

  impactScore       Int?     @map("impact_score")
  effortScore       Int?     @map("effort_score")
  evidenceSeverity  Int?     @map("evidence_severity")
  evidenceMissing   Boolean  @default(false) @map("evidence_missing")
  priorityScore     Decimal? @map("priority_score") @db.Decimal(8, 2)
  originScore       Decimal? @map("origin_score") @db.Decimal(6, 2)
  originType        String?  @map("origin_type")
  originKey         String?  @map("origin_key")
  originDetail      String?  @map("origin_detail")
  questionActionId  String?  @map("question_action_id") @db.Uuid

  howToExecute       String? @map("how_to_execute")
  executionGuidance  String? @map("execution_guidance")
  expectedEvidence   String? @map("expected_evidence")
  completionEvidence String? @map("completion_evidence")
  blockedReason      String? @map("blocked_reason")

  lastCheckinAt      DateTime? @map("last_checkin_at")
  lastCheckinComment String?   @map("last_checkin_comment")
  lastUpdatedBy      String?   @map("last_updated_by")

  frequency            String?  @default("once")
  reason               String?
  dependencyTaskKeys   String[] @map("dependency_task_keys")
  isBlocked            Boolean  @default(false) @map("is_blocked")

  status             String    @default("todo")
  progressPercentage Int       @default(0) @map("progress_percentage")
  assignedTo         String?   @map("assigned_to")
  ownerName          String?   @map("owner_name")
  startDate          DateTime? @map("start_date") @db.Date
  dueDate            DateTime? @map("due_date") @db.Date
  completedAt        DateTime? @map("completed_at")

  isManual           Boolean  @default(false) @map("is_manual")
  isSystemGenerated  Boolean  @default(true) @map("is_system_generated")
  consultantNotes    String?  @map("consultant_notes")
  evidenceQuestions  String[] @map("evidence_questions")
  playbookKey        String?  @map("playbook_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  plan   ActionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  activities ActionTaskActivity[]
  taskReviews ActionTaskReview[]

  @@unique([planId, taskKey])
  @@index([tenantId, status])
  @@index([planId])
  @@map("action_tasks")
}

/// Log de auditoria de toda mudança em uma ActionTask (histórico completo).
model ActionTaskActivity {
  id           String @id @default(uuid()) @db.Uuid
  actionTaskId String @map("action_task_id") @db.Uuid
  actionPlanId String @map("action_plan_id") @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  operationId  String @map("operation_id")
  commitStatus String @default("active") @map("commit_status")

  type          String
  before        Json?
  after         Json?
  changedFields String[] @map("changed_fields")
  reviewId      String?  @map("review_id") @db.Uuid
  comment       String?
  note          String?
  actor         String?
  timestamp     DateTime @default(now())
  createdBy     String?  @map("created_by")

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  task   ActionTask @relation(fields: [actionTaskId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([actionTaskId])
  @@map("action_task_activities")
}

/// Mudança de uma ActionTask registrada dentro de uma ActionPlanReview
/// (visita do consultor) — histórico "antes/depois" por ciclo de revisão.
model ActionTaskReview {
  id                  String @id @default(uuid()) @db.Uuid
  actionPlanReviewId  String @map("action_plan_review_id") @db.Uuid
  actionPlanId        String @map("action_plan_id") @db.Uuid
  actionTaskId        String @map("action_task_id") @db.Uuid
  tenantId            String @map("tenant_id") @db.Uuid
  operationId         String @map("operation_id")
  commitStatus        String @default("active") @map("commit_status")

  previousStatus              String?  @map("previous_status")
  newStatus                   String?  @map("new_status")
  previousProgressPercentage  Int?     @map("previous_progress_percentage")
  newProgressPercentage       Int?     @map("new_progress_percentage")
  consultantComment           String?  @map("consultant_comment")
  clientComment                String? @map("client_comment")
  evidenceUrls                String[] @map("evidence_urls")
  changeType                   String  @map("change_type")
  changes                      Json?
  createdBy                    String? @map("created_by")
  createdAt                    DateTime @default(now()) @map("created_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  review ActionPlanReview @relation(fields: [actionPlanReviewId], references: [id], onDelete: Cascade)
  task   ActionTask       @relation(fields: [actionTaskId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([actionPlanReviewId])
  @@map("action_task_reviews")
}

/// Recomendação pendente de classificação/aprovação antes de virar ActionTask
/// — pode nascer do motor FAL (generateActionRecommendations), de um achado
/// financeiro (sendFindingToActionPlan — não portado, ver nota de escopo) ou
/// manual do consultor.
model ActionRecommendation {
  id                    String  @id @default(uuid()) @db.Uuid
  tenantId              String  @map("tenant_id") @db.Uuid
  assessmentId          String? @map("assessment_id") @db.Uuid
  actionPlanId          String? @map("action_plan_id") @db.Uuid

  /// Sem FK — o domínio financeiro "Frente B" (achados/recomendações) ainda
  /// não foi migrado pro Postgres, continua só no mock local.
  financialDiagnosisId  String? @map("financial_diagnosis_id")
  financialFindingId    String? @map("financial_finding_id")

  sourceType     String  @default("manual") @map("source_type")
  sourceRefId    String? @map("source_ref_id")
  dimensionKey   String? @map("dimension_key")
  subdimensionKey String? @map("subdimension_key")
  clusterKey     String? @map("cluster_key")
  questionId     String? @map("question_id")

  /// Entidade avaliada (assessment multi_entity_master) — ver nota igual em
  /// ActionTask.evaluatedEntityId. Só populado pra sugestões operacionais.
  evaluatedEntityId   String? @map("evaluated_entity_id") @db.Uuid
  evaluatedEntityType String? @map("evaluated_entity_type")
  evaluatedEntityName String? @map("evaluated_entity_name")

  title               String
  recommendationText  String  @map("recommendation_text")
  rationale           String?
  practicalSteps      String? @map("practical_steps")
  evidenceRequired    String? @map("evidence_required")
  expectedDeliverable String? @map("expected_deliverable")
  expectedResult      String? @map("expected_result")

  suggestedOwnerArea      String?  @map("suggested_owner_area")
  suggestedDeadlineDays   Int?     @map("suggested_deadline_days")
  priority                String   @default("medium")
  impactScore             Int?     @map("impact_score")
  effortScore             Int?     @map("effort_score")
  complexityLevel         String?  @map("complexity_level")
  consultantOriginContext String?  @map("consultant_origin_context")

  /// Campos abaixo existem só pra sugestões geradas pelo motor de
  /// generateActionPlan (candidatos estratégicos/operacionais que passaram a
  /// nascer como recomendação, não mais tarefa direta — ver nota de escopo
  /// em action-plan.service.ts). Preservam fidelidade total: quando a
  /// recomendação é aprovada e convertida, a ActionTask resultante usa esses
  /// valores em vez de recalcular do zero ou usar default genérico.
  taskLayer          String?  @map("task_layer")
  horizon            String?
  howToExecute       String?  @map("how_to_execute")
  expectedEvidence   String?  @map("expected_evidence")
  frequency          String?
  dependencyTaskKeys String[] @map("dependency_task_keys")
  playbookKey        String?  @map("playbook_key")
  actionLibraryKey   String?  @map("action_library_key")
  questionActionId   String?  @map("question_action_id") @db.Uuid
  evidenceSeverity   Int?     @map("evidence_severity")
  evidenceMissing    Boolean? @map("evidence_missing")
  evidenceQuestions  String[] @map("evidence_questions")
  originScore        Decimal? @map("origin_score") @db.Decimal(6, 2)
  originType         String?  @map("origin_type")
  originKey          String?  @map("origin_key")
  originDetail       String?  @map("origin_detail")

  status           String    @default("needs_classification")
  approvedBy       String?   @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  rejectedReason   String?   @map("rejected_reason")
  convertedTaskIds String[]  @map("converted_task_ids")
  convertedAt      DateTime? @map("converted_at")
  convertedBy      String?   @map("converted_by")

  suggestToLibrary Boolean @default(false) @map("suggest_to_library")
  libraryEntryId   String? @map("library_entry_id") @db.Uuid
  createdBy        String? @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  plan   ActionPlan? @relation(fields: [actionPlanId], references: [id])

  @@index([tenantId, status])
  @@index([actionPlanId])
  @@index([assessmentId])
  @@map("action_recommendations")
}

