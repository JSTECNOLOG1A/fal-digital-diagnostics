/// Recomendações por cluster (independente de trigger_score — comparar com
/// FalRecommendationLibrary, que é por trigger_score) — biblioteca global.
model FalClusterRecommendation {
  id                        String  @id @default(uuid()) @db.Uuid
  clusterKey                String  @map("cluster_key")
