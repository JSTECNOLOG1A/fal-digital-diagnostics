# Método FAL — frontend Vite + nginx (SPA + proxy /api)
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.js tailwind.config.js postcss.config.js jsconfig.json components.json ./
COPY public ./public
COPY scripts ./scripts
COPY src ./src
COPY base44 ./base44

# Build-time: same-origin via nginx → /api/v1
ARG VITE_CLARITY_API_URL=/api/v1
ARG VITE_LOCAL_TEST_AUTH=false
ARG VITE_BASE44_APP_ID=production
ARG VITE_BASE44_APP_BASE_URL=
ARG VITE_CLARITY_AUTH=true
ARG VITE_CLARITY_HIERARCHY=true
ARG VITE_CLARITY_USERS=true
ARG VITE_CLARITY_PROTHEUS=true
ARG VITE_CLARITY_INTEGRATIONS=true

ENV VITE_CLARITY_API_URL=$VITE_CLARITY_API_URL \
    VITE_LOCAL_TEST_AUTH=$VITE_LOCAL_TEST_AUTH \
    VITE_BASE44_APP_ID=$VITE_BASE44_APP_ID \
    VITE_BASE44_APP_BASE_URL=$VITE_BASE44_APP_BASE_URL \
    VITE_CLARITY_AUTH=$VITE_CLARITY_AUTH \
    VITE_CLARITY_HIERARCHY=$VITE_CLARITY_HIERARCHY \
    VITE_CLARITY_USERS=$VITE_CLARITY_USERS \
    VITE_CLARITY_PROTHEUS=$VITE_CLARITY_PROTHEUS \
    VITE_CLARITY_INTEGRATIONS=$VITE_CLARITY_INTEGRATIONS

RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=20s --timeout=5s --retries=5 \
  CMD wget -qO- http://127.0.0.1/healthz || exit 1
