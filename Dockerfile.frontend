FROM node:22-bookworm-slim

WORKDIR /app

COPY package*.json ./
RUN npm ci

EXPOSE 5174

# Código real vem do bind mount (docker-compose.yml) — editar no host e o
# Vite recarrega sozinho (HMR), sem precisar reiniciar o container na
# maioria dos casos. vite.config.js já fixa host:true e port:5174.
CMD ["npm", "run", "dev"]
